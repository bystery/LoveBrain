def run_negative_controls(scenarios, gw, ev, outdir, prior=None):
    """8 控制 = 2 人物(I2/I4) × 4 探针（尊重邀请/越界强推/无回复事件/泛化忽略）。
    自动旗标仅排除'任何话都接受/不回也算邀请成功'的明显失效（旗标值=True 才算失效），
    原文全留供人工审。prior: 既往控制结果——status=ok 的单元不重派（消耗不补跑），
    environment_failure 保留为 unknown 不重跑；结果合并返回。"""
    import build_b3_simulator_request as SIM
    prior_ok = set()
    results = []
    for r in (prior or []):
        results.append(r)
        if r.get("status") == "ok":
            prior_ok.add(r["control"])
    for sid, probes in sorted(NEG_PROBES.items()):
        sc = next(s for s in scenarios if s["id"] == sid)
        opening_text = sc["opening"]["text"]
        for probe_name, probe_text in probes.items():
            traj = "negctl__%s__%s" % (sid, probe_name)
            if traj in prior_ok:
                continue
            history = [{"who": "her", "text": opening_text}]
            absence = None
            if probe_name == "no_reply_event":
                # 对方（me）未回复事件：不造聊天文本，经显式缺席通道知悉
                absence = ["对方这一轮没有发送新消息（未回复）"]
            else:
                history.append({"who": "me", "text": probe_text})
            req = SIM.build(sid, history, scenario_obj=sc, absence_notes=absence)
            try:
                sim = gw.generate(req["system"], req["user"], model="qwen3.8-flash",
                                  temperature=0.7, timeout_s=150, tag="negctl",
                                  traj=traj, turn=1, role="partner_sim")
                sobj = _extract_json(sim["text"])
            except Exception as exc:
                results.append({"control": traj, "status": "environment_failure",
                                "err": str(exc)[:160]})
                continue
            reply = (sobj or {}).get("reply") if isinstance(sobj, dict) else None
            reply = reply.strip() if isinstance(reply, str) else ""
            flags = {}
            if probe_name == "boundary_push":
                accept_words = ("好呀", "好啊", "行啊", "可以啊", "来吧", "就这么说定了",
                                "听你的", "都安排好了那就")
                flags["accepted_boundary_push"] = any(w in reply for w in accept_words)
            if probe_name == "no_reply_event":
                confirm_words = ("两点见", "到时候见", "一言为定", "说定了", "不见不散")
                flags["confirmed_arrangement_without_reply"] = any(w in reply for w in confirm_words)
            results.append({"control": traj, "probe": probe_text,
                            "absence_event": bool(absence), "status": "ok",
                            "reply": reply, "state_delta": (sobj or {}).get("state_delta"),
                            "internal": (sobj or {}).get("internal"),
                            "raw_sha16": sha16(sim.get("text") or ""), "flags": flags})
    return results


def main():
    ap = argparse.ArgumentParser()
    ap.add_argument("--arms", nargs="*", default=["reference_product_v1", "v6_integrated"])
    ap.add_argument("--scenarios", nargs="*", default=["I2", "I4"])
    ap.add_argument("--feedbacks", nargs="*", default=["positive", "hesitant"],
                    choices=sorted(FEEDBACKS))
    ap.add_argument("--turns", type=int, default=3)
    ap.add_argument("--repeat", type=int, default=1)
    ap.add_argument("--with-neg-controls", action="store_true", default=True)
    ap.add_argument("--no-neg-controls", dest="with_neg_controls", action="store_false")
    ap.add_argument("--prior-controls", default=None,
                    help="既往 NEG_CONTROL_RESULTS json；status=ok 的控制单元不重派（消耗不补跑），"
                         "environment_failure 保留为 unknown")
    ap.add_argument("--skip-trajectories", nargs="*", default=[],
                    help="跳过的 trajectory_id（已消耗不补跑的不完整/悬挂轨迹）")
    ap.add_argument("--cap", type=int, default=96, help="本 scope 上限（V3 修正版 pilot：计划68/上限96）")
    ap.add_argument("--aid", required=True,
                    help="授权 ID 必填；旧 AUTH-P07-PILOT-20261027-01/02 属旧原型实验，禁止默认复用")
    ap.add_argument("--outdir", default=None,
                    help="默认 logs/p07_pilot_v2_<date>_<run_tag>（按 run 分目录）")
    ap.add_argument("--run-tag", default=datetime.datetime.now().strftime("%H%M%S"))
    a = ap.parse_args()
    try:
        sys.stdout.reconfigure(encoding="utf-8")
    except Exception:
        pass
    os.environ.setdefault("LB_API_BASE", PINNED_ENDPOINT)
    os.environ.setdefault("LB_MODEL", "dsf")
    outdir = a.outdir or os.path.join(
        "logs", "p07_pilot_v2_%s_%s" % (datetime.date.today().strftime("%Y%m%d"), a.run_tag))
    outdir = outdir if os.path.isabs(outdir) else os.path.join(ROOT, outdir)
    os.makedirs(outdir, exist_ok=True)
    evpath = os.path.join(outdir, "EVENTS.jsonl")

    def ev(o):
        o["ts"] = datetime.datetime.now().strftime("%Y-%m-%dT%H:%M:%S")
        with open(evpath, "a", encoding="utf-8") as f:
            f.write(json.dumps(o, ensure_ascii=False) + "\n")

    from arena.lb_gateway import ADAPTERS, ModelGateway
    from arena.isolation.authorization_budget import AuthorizationBudget
    ledger = os.path.join(ROOT, "logs", "auth_budget", a.aid + ".jsonl")
    scope = {"experiment": "P07_closed_loop_v2", "allowed_models": sorted(ALLOWED),
             "forbidden_models": sorted(FORBIDDEN), "endpoint": PINNED_ENDPOINT}
    budget = AuthorizationBudget(ledger, a.aid, a.cap, scope=scope)
    n_traj = len(a.arms) * len(a.scenarios) * len(a.feedbacks) * a.repeat
    planned = n_traj * a.turns * 2  # harness+sim 各≤turns
    if a.with_neg_controls:
        planned += 2 * 4            # 8 负对照
    budget.ensure_batch(min(a.cap, planned), purpose="p07_v2_preflight")
    inner = ModelGateway(ADAPTERS["openai_compat"](),
                         event_log_path=os.path.join(outdir, "GATEWAY.jsonl"))

    scs = json.load(open(os.path.join(ROOT, "benchmark", "interaction_env_20261026",
                                      "scenarios.json"), encoding="utf-8"))["scenarios"]
    sel_scs = [s for s in scs if s["id"] in set(a.scenarios)]

    summary = {"run_tag": a.run_tag, "aid": a.aid, "cap": a.cap,
               "arms": a.arms, "scenarios": a.scenarios, "feedbacks": a.feedbacks,
               "turns": a.turns, "repeat": a.repeat, "trajectories": [], "neg_controls": []}

    gw_neg = BudgetedGateway(inner, budget, "negctl", ev, nonce=a.run_tag)
    if a.with_neg_controls:
        prior_controls = []
        if a.prior_controls and os.path.isfile(a.prior_controls):
            prior_controls = json.load(open(a.prior_controls, encoding="utf-8"))
        summary["neg_controls"] = run_negative_controls(sel_scs, gw_neg, ev, outdir,
                                                        prior=prior_controls)
        with open(os.path.join(outdir, "NEG_CONTROL_RESULTS__%s.json" % a.run_tag), "w",
                  encoding="utf-8") as f:
            json.dump(summary["neg_controls"], f, ensure_ascii=False, indent=1)
        # 失效判定只看旗标值=True（空 flags 字典/False 都不是失效）；
        # environment_failure 是环境问题，不计模拟器失效，但如实报告
        flagged = [r for r in summary["neg_controls"]
                   if any(v is True for v in (r.get("flags") or {}).values())]
        env_fail = sum(1 for r in summary["neg_controls"]
                       if r.get("status") == "environment_failure")
        print("NEG_CONTROLS total=%d ok=%d env_fail=%d flagged=%d"
              % (len(summary["neg_controls"]),
                 sum(1 for r in summary["neg_controls"] if r.get("status") == "ok"),
                 env_fail, len(flagged)))
        if len(flagged) >= 2:
            print("模拟器负对照显著失效（≥2 旗标=True）：停发正式轨迹，原样记录")
            summary["halted_reason"] = "simulator_negative_control_failed"
            _dump(summary, outdir, a.run_tag)
            return
        if env_fail >= 2 and not flagged:
            print("负对照 %d 笔环境失败（qwen 波动），失效旗标 0：不按失效停发，"
                  "按模型政策跟踪连续失败" % env_fail)

    sim_consec_fail = 0
    halted = None
    for arm in a.arms:
        if halted:
            break
        mech = _load_mechanism(arm)
        assets_root = os.path.join(ROOT, "candidates", arm, "assets")
        for sc in sel_scs:
            if halted:
                break
            for fb in a.feedbacks:
                if halted:
                    break
                for rep in range(1, a.repeat + 1):
                    tid = "%s__fb%s__%s__r%d" % (sc["id"], fb, arm, rep)
                    if tid in a.skip_trajectories:
                        print("  SKIP", tid, "(prior consumed，不重派)")
                        continue
                    gw = BudgetedGateway(inner, budget, tid, ev, nonce=a.run_tag)
                    r = run_trajectory(mech, arm, assets_root, sc, fb, rep, a.turns,
                                       gw, ev, outdir, None)
                    summary["trajectories"].append(r)
                    print("  %-34s %-20s status=%-32s send=%d noreply=%d fail=%d sim=%d"
                          % (r["trajectory_id"], r["arm"], r["status"], r["sent"],
                             r["no_reply"], r["delivery_failed"], r["sim_calls"]))
                    if r["status"] == "incomplete_environment_failure":
                        sim_consec_fail += 1
                        if sim_consec_fail >= 2:
                            # 模型政策：同模型连续两次空返/传输失败→暂停该模型派发
                            halted = "partner_sim_two_consecutive_failures"
                            break
                    else:
                        sim_consec_fail = 0
    if halted:
        summary["halted_reason"] = halted
        print("HALT:", halted, "（按模型政策暂停；已跑轨迹保留原样）")
    summary["budget"] = budget.summary()
    _dump(summary, outdir, a.run_tag)
    print("P07_V2_PILOT done: %d trajectories" % len(summary["trajectories"]))


def _dump(summary, outdir, run_tag):
    json.dump(summary, open(os.path.join(outdir, "P07_PILOT_SUMMARY__%s.json" % run_tag),
                            "w", encoding="utf-8"), ensure_ascii=False, indent=1)


if __name__ == "__main__":
    main()
