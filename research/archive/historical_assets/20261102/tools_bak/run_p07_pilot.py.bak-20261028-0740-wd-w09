NO_REPLY_ACTIONS = {"停", "收尾", "不回", "no_reply", "结束"}


def _load_mechanism(arm):
    path = os.path.join(ROOT, "candidates", arm, "mechanism", "mechanism.py")
    spec = importlib.util.spec_from_file_location("p07_mech_" + re.sub(r"\W", "_", arm), path)
    mod = importlib.util.module_from_spec(spec)
    spec.loader.exec_module(mod)
    return mod


def _extract_json(text):
    if not text:
        return None
    t = text.strip()
    if t.startswith("```"):
        t = re.sub(r"^```[a-zA-Z]*", "", t).strip().rstrip("`").strip()
    try:
        return json.loads(t)
    except Exception:
        m = re.search(r"\{.*\}", t, re.S)
        if m:
            try:
                return json.loads(m.group(0))
            except Exception:
                return None
    return None


def classify_reply(obj, may_decline):
    """V3 2B：权威动作语义（空对象≠no_reply；no_reply+正文=冲突；may_decline 按轮许可）。
    → (kind, sendable_text, reason)。kind ∈ {send, no_reply, delivery_failed}。"""
    if not isinstance(obj, dict):
        return "delivery_failed", "", "not_object"
    resp = obj.get("response")
    if not isinstance(resp, dict):
        return "delivery_failed", "", "no_response_object"
    rec = resp.get("recommended")
    rec = rec.strip() if isinstance(rec, str) else ""
    ana = obj.get("analysis") if isinstance(obj.get("analysis"), dict) else {}
    act = (ana.get("action_taken") or "").strip() if isinstance(ana, dict) else ""
    wants_no_reply = (act in NO_REPLY_ACTIONS) or bool(obj.get("decline_reason"))
    if rec:
        if wants_no_reply:
            return "delivery_failed", "", "action_conflict:no_reply_with_body"
        return "send", rec, "ok"
    if obj.get("decline_reason") and may_decline:
        return "no_reply", "", "decline_allowed"
    if act in NO_REPLY_ACTIONS and may_decline:
        return "no_reply", "", "action_no_reply_allowed"
    return "delivery_failed", "", "empty_or_unlicensed_no_reply"


def sha16(s):
    return hashlib.sha256((s or "").encode("utf-8")).hexdigest()[:16]


def logical_ts(base_dt, k):
    return (base_dt + datetime.timedelta(minutes=5 * k)).strftime("%Y-%m-%d %H:%M")


class BudgetedGateway(object):
    """每次 generate 先精确 allowlist 校验再 reserve（唯一 attempt_id）；成功/失败都落账。
    attempt_id 含 trajectory/node：p07:<node>:<nonce>:<tag>:<seq>（B8）。无隐式重试。"""

    def __init__(self, inner, budget, node, event_logger, nonce="r1"):
        self.inner = inner
        self.budget = budget
        self.node = node
        self.nonce = nonce
        self.seq = 0
        self.ev = event_logger

    def generate(self, system, user, images=None, model=None, temperature=None,
                 timeout_s=120, tag="harness", traj=None, turn=None, role=None):
        role_model = model or os.environ.get("LB_MODEL", "")
        if role_model in FORBIDDEN or role_model not in ALLOWED:
            raise RuntimeError("模型越权/被禁: %r (allowlist=%s forbidden=%s)"
                               % (role_model, sorted(ALLOWED), sorted(FORBIDDEN)))
        self.seq += 1
        aid = "p07:%s:%s:%s:%d" % (self.node, self.nonce, tag, self.seq)
        self.budget.reserve(aid, purpose=PURPOSE.get(tag.split("_")[0], tag))
        t0 = time.time()
        err = None
        try:
            res = self.inner.generate(system, user, images=images, model=model,
                                      temperature=temperature if temperature is not None else 0.7,
                                      timeout_s=timeout_s, tag=tag, attempt_id=aid)
            if not (res.get("text") or "").strip():
                err = "empty_content_response"
                self.budget.record("attempt_failed", aid, error=err)
                raise RuntimeError(err)
            self.budget.record("attempt_completed", aid, model=role_model,
                               usage=res.get("usage"))
        except Exception as exc:
            if err is None:
                err = "%s: %s" % (type(exc).__name__, str(exc)[:150])
                self.budget.record("attempt_failed", aid, error=err)
            self.ev({"event": "call_fail", "attempt_id": aid, "tag": tag, "traj": traj,
                     "turn": turn, "role": role, "model": role_model, "error": err})
            raise
        self.ev({"event": "call_ok", "attempt_id": aid, "tag": tag, "traj": traj,
                 "turn": turn, "role": role, "model": role_model,
                 "ms": int((time.time() - t0) * 1000),
                 "reply_chars": len(res.get("text") or "")})
        return res


def run_trajectory(mech, arm, assets_root, scenario, feedback, repeat, turns,
                   gw, ev, outdir, scenarios_root_json):
    sid = scenario["id"]
    traj_id = "%s__fb%s__%s__r%d" % (sid, feedback, arm, repeat)
    sandbox = os.path.join(outdir, "sandbox_" + traj_id)
    os.makedirs(sandbox, exist_ok=True)
    fb = FEEDBACKS[feedback]
    base_dt = datetime.datetime.strptime(LOGICAL_CLOCK_BASE, "%Y-%m-%d %H:%M")
    me_ctx = scenario.get("me_context") or {}
    goal_text = (me_ctx.get("goal") or "") + fb["goal_suffix"]
    h = mech.init(assets_root, {
        "episode_id": "P07V2_" + traj_id,
        "persona": {"me": "我", "her": scenario["her"]["persona"]},
        "initial_kb": {},
    }, gw, sandbox)

    uid_seq = [0]

    def new_uid():
        uid_seq[0] += 1
        return "m%03d" % uid_seq[0]

    opening = {"who": "her", "text": scenario["opening"]["text"],
               "message_uid": new_uid(), "ts": logical_ts(base_dt, 0)}
    history = [dict(opening)]
    control_events = []          # B3：缺席/失败是事件，不是聊天
    consumed_cursor = 0          # history 中已被 harness 消费过的条数（B2 事件只写一次）
    trace = []
    sim_calls = 0
    harness_calls = 0
    consec_fail = 0
    status = "complete"
    import build_b3_simulator_request as SIM

    for k in range(1, turns + 1):
        # ---- B2：ctx = 上轮实际已发 ME + 本轮新 HER（自消费游标之后的真实事件）----
        msgs = []
        for entry in history[consumed_cursor:]:
            msgs.append({"role": "ME" if entry["who"] == "me" else "HER",
                         "text": entry["text"], "ts": entry["ts"],
                         "message_uid": entry["message_uid"]})
        consumed_cursor = len(history)
        intent = {"text": goal_text, "status": fb["intent_status"], "enabled": True}
        ctx = {"turn_index": k, "input": {
            "clock": logical_ts(base_dt, k), "may_decline": fb["may_decline"],
            "messages": msgs, "note": None, "intent": intent}}
        cand_model = os.environ.get("LB_MODEL", "dsf")
        turn_rec = {"turn": k, "ctx": ctx, "ctx_sha16": sha16(json.dumps(ctx, ensure_ascii=False)),
                    "her_input": (msgs[-1]["text"] if msgs and msgs[-1]["role"] == "HER" else None),
                    "arm": arm, "trajectory_id": traj_id, "feedback": feedback}
        try:
            r = mech.run_turn(h, ctx, gw)
            harness_calls += 1
            reply_raw = r.get("reply") if isinstance(r, dict) else str(r)
            # B6：先过共同归一器（Praw 失败保留；规范结果按动作/结构条件发）
            import normalize_reply_contract as NRM
            norm = NRM.normalize_raw(reply_raw)
            obj = norm["canonical"]
            kind, sendable, creason = classify_reply(obj, fb["may_decline"])
            turn_rec.update({"candidate_raw": reply_raw, "raw_sha16": sha16(reply_raw),
                             "praw_ok": norm["praw_ok"], "norm_repairs": norm["repairs"],
                             "norm_unmapped": norm["unmapped"],
                             "norm_missing_slots": norm["missing_slots"],
                             "candidate_kind": kind, "send": sendable,
                             "classify_reason": creason})
            consec_fail = 0 if kind != "delivery_failed" else consec_fail + 1
        except Exception as exc:   # 机制/交付层异常：交付失败，消耗不退款
            harness_calls += 1
            reply_raw, kind, sendable = "", "delivery_failed", ""
            turn_rec.update({"candidate_raw": "", "praw_ok": False,
                             "candidate_kind": kind, "classify_reason": "exception",
                             "exception": str(exc)[:200]})
            ev({"event": "candidate_exc", "traj": traj_id, "turn": k, "err": str(exc)[:160]})
            consec_fail += 1
        trace.append(turn_rec)
        # ---- 发送/不回：B3 不再伪造 ME 聊天文本 ----
        if kind == "send":
            entry = {"who": "me", "text": sendable, "message_uid": new_uid(),
                     "ts": logical_ts(base_dt, k)}
            history.append(entry)
            turn_rec["sent_message_uid"] = entry["message_uid"]
        else:
            control_events.append({"type": kind, "turn": k,
                                   "ts": logical_ts(base_dt, k),
                                   "reason": turn_rec.get("classify_reason")})
        if consec_fail >= 2:
            ev({"event": "pause_model", "traj": traj_id,
                "reason": "2 连续交付失败（同模型连续失败暂停该角色派发）"})
            status = "paused_consecutive_failures"
            break
        # ---- 对方模拟器：读实际已发文本；无 ME 发送时经显式缺席事件知悉（B3）----
        absence = [c for c in control_events if c["turn"] == k]
        req = SIM.build(sid, history,
                        scenario_obj=scenario,
                        extra_rules=[fb["sim_extra_rule"]] if fb["sim_extra_rule"] else None,
                        absence_notes=[("对方这一轮没有发送新消息（未回复）") for c in absence])
        try:
            sim = gw.generate(req["system"], req["user"], model="qwen3.8-flash",
                              temperature=0.7, timeout_s=150, tag="sim",
                              traj=traj_id, turn=k, role="partner_sim")
            sim_calls += 1
            sobj = _extract_json(sim["text"])
        except Exception as exc:
            ev({"event": "sim_exc", "traj": traj_id, "turn": k, "err": str(exc)[:160]})
            status = "incomplete_environment_failure"
            trace[-1]["sim_failure"] = str(exc)[:200]
            break
        if not isinstance(sobj, dict):
            ev({"event": "sim_bad", "traj": traj_id, "turn": k,
                "raw": (sim.get("text") or "")[:300]})
            status = "incomplete_environment_failure"
            trace[-1]["sim_failure"] = "unparseable_sim_output"
            break
        # ---- B4：模拟器可以 wait/end；没新 HER 就不凭空请求候选下一句 ----
        her_text = sobj.get("reply")
        her_text = her_text.strip() if isinstance(her_text, str) else ""
        trace[-1]["sim_delta"] = sobj.get("state_delta")
        trace[-1]["sim_internal"] = sobj.get("internal")
        trace[-1]["sim_raw_sha16"] = sha16(sim.get("text") or "")
        if sobj.get("end_dialog"):
            trace[-1]["sim_end_dialog"] = True
            break
        if not her_text:
            control_events.append({"type": "sim_wait", "turn": k,
                                   "ts": logical_ts(base_dt, k)})
            trace[-1]["sim_wait"] = True
            # wait：无新 HER；下一轮 ctx 不伪造消息
            continue
        entry = {"who": "her", "text": her_text, "message_uid": new_uid(),
                 "ts": logical_ts(base_dt, k)}
        history.append(entry)

    with open(os.path.join(outdir, "TRACE_%s.json" % traj_id), "w", encoding="utf-8") as f:
        json.dump({"trajectory_id": traj_id, "scenario": sid, "feedback": feedback,
                   "arm": arm, "repeat": repeat, "turns_planned": turns,
                   "status": status, "harness_calls": harness_calls,
                   "sim_calls": sim_calls, "control_events": control_events,
                   "logical_clock_base": LOGICAL_CLOCK_BASE,
                   "trace": trace, "final_history": history},
                  f, ensure_ascii=False, indent=1)
    return {"trajectory_id": traj_id, "arm": arm, "scenario": sid, "feedback": feedback,
            "repeat": repeat, "status": status, "harness_calls": harness_calls,
            "sim_calls": sim_calls,
            "sent": sum(1 for t in trace if t.get("candidate_kind") == "send"),
            "no_reply": sum(1 for t in trace if t.get("candidate_kind") == "no_reply"),
            "delivery_failed": sum(1 for t in trace if t.get("candidate_kind") == "delivery_failed")}


