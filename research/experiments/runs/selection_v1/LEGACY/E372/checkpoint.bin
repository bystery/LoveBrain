HER", "relation": "合租账目", "evidence_uids": [0], "evidence_quotes": ["水电网我垫的，一共 96，你一半 48"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-10", "valid_from": "2026-11-09 20:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 20:22", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "收款码贴在她冰箱上那张", "subject": "HER", "relation": "合租账目", "evidence_uids": [0], "evidence_quotes": ["收款码就冰箱上那张"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-09 20:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 20:22", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "热水器又只出冷水", "subject": "HER", "relation": "家里设备故障", "evidence_uids": [1], "evidence_quotes": ["热水器又只出冷水"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 早上", "valid_from": "2026-11-10 08:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 08:58", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "她昨晚没把热水器的事发给房东", "subject": "HER", "relation": "待办改口", "evidence_uids": [1], "evidence_quotes": ["我昨天光顾着想，微信压根没发"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 晚", "valid_from": "2026-11-10 08:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 08:58", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "她问我今天在不在家", "subject": "HER", "relation": "安排", "evidence_uids": [1], "evidence_quotes": ["你今天在家吧？"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 08:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 08:58", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她打算现在发微信让房东今天来看热水器", "subject": "UNKNOWN", "relation": "", "evidence_uids": [1, 2], "evidence_quotes": ["我现在就发，你今天在家吧？", "房东回了，师傅明天下午三点上门看热水器"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-10 08:58", "valid_to": "2026-11-10 21:38", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 08:58", "history": [{"status": "proposed", "text": "她打算现在发微信让房东今天来看热水器", "valid_to": "2026-11-10 21:38", "reason": "complete", "src_uids": [2], "quote": "房东回了，师傅明天下午三点上门看热水器"}]}, "f_0013": {"fact_id": "f_0013", "text": "房东安排的师傅明天下午三点上门看热水器", "subject": "SHARED", "relation": "房屋维修安排", "evidence_uids": [2], "evidence_quotes": ["房东回了，师傅明天下午三点上门看热水器"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 15:00", "valid_from": "2026-11-10 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:38", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "她明天全天外勤", "subject": "HER", "relation": "工作安排", "evidence_uids": [2], "evidence_quotes": ["我明天全天外勤"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-10 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:38", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "她问我明天能否在家给师傅开门", "subject": "HER", "relation": "请求确认", "evidence_uids": [2], "evidence_quotes": ["你在家能开门不？"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 21:30", "valid_from": "2026-11-10 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:38", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "若我不在家，就让师傅用楼下智能钥匙盒，密码她到时发我", "subject": "UNKNOWN", "relation": "", "evidence_uids": [2], "evidence_quotes": ["不行就让他把钥匙放楼下智能钥匙盒，密码我到时候发你"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-10 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:38", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她表妹小蒲明晚过来住一晚，睡客厅沙发", "subject": "HER", "relation": "家人/借住安排", "evidence_uids": [3], "evidence_quotes": ["我表妹小蒲明晚过来住一晚，睡客厅沙发"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 晚", "valid_from": "2026-11-11 19:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:12", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她下班带表妹在外面吃，表妹八点多到", "subject": "HER", "relation": "时间安排", "evidence_uids": [3], "evidence_quotes": ["我下班带她外面吃，她八点多才到"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 晚", "valid_from": "2026-11-11 19:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:12", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "她让玄关留一盏灯", "subject": "HER", "relation": "请求", "evidence_uids": [3], "evidence_quotes": ["玄关那盏灯给我留一盏就行"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 晚", "valid_from": "2026-11-11 19:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:12", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "十月那96元里不含燃气，燃气单另算34元，单子贴在96那张下面", "subject": "HER", "relation": "账目", "evidence_uids": [4], "evidence_quotes": ["十月那 96 里没有燃气！燃气单是另算的 34，单子就贴在 96 那张下面"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-10", "valid_from": "2026-11-12 09:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 09:48", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "我应转她48加17，共65元", "subject": "HER", "relation": "账目", "evidence_uids": [4], "evidence_quotes": ["所以你该转的是 48 加 17，一共 65"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12", "valid_from": "2026-11-12 09:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 09:48", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "她表妹小蒲到了，她们在楼下吃饭", "subject": "HER", "relation": "表妹来访", "evidence_uids": [5], "evidence_quotes": ["小蒲到了，我们在楼下吃"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 晚", "valid_from": "2026-11-12 22:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 22:28", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "小蒲明早七点的高铁", "subject": "THIRD", "relation": "行程", "evidence_uids": [5], "evidence_quotes": ["她明早七点的高铁"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13 07:00", "valid_from": "2026-11-12 22:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 22:28", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "她让我把客厅那盏灯留到小蒲走", "subject": "HER", "relation": "请求", "evidence_uids": [5], "evidence_quotes": ["客厅那盏灯留到她走"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 夜", "valid_from": "2026-11-12 22:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 22:28", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "明天十点开始大扫除，她负责客厅加厨房，我负责卫生间加阳台，冰箱过期的东西清一遍", "subject": "SHARED", "relation": "家务分工约定", "evidence_uids": [6], "evidence_quotes": ["明天大扫除十点开始：我客厅加厨房，你卫生间加阳台，冰箱过期的清一遍。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 10:00", "valid_from": "2026-11-13 18:52", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:52", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "她说干完活请我吃楼下牛肉面，加蛋", "subject": "HER", "relation": "请客约定", "evidence_uids": [6], "evidence_quotes": ["干完我请你楼下牛肉面，加蛋那种。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-13 18:52", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:52", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "我负责的卫生间和阳台已完工，扔了两瓶过期酸奶，酱油大半瓶没动", "subject": "ME", "relation": "大扫除进度", "evidence_uids": [7], "evidence_quotes": ["卫生间阳台完工，冰箱过期酸奶扔了两瓶，酱油大半瓶没动。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 11:20", "valid_from": "2026-11-14 11:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 11:38", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "她客厅已吸完尘，油烟机滤网打算下周再洗，要我别催", "subject": "HER", "relation": "大扫除进度", "evidence_uids": [8], "evidence_quotes": ["客厅吸完尘了，油烟机滤网我想拆下来洗，算了下周再说，你别催我。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 11:30", "valid_from": "2026-11-14 11:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 11:38", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "油烟机滤网下周再拆下来洗", "subject": "UNKNOWN", "relation": "", "evidence_uids": [8], "evidence_quotes": ["算了下周再说"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 11:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 11:38", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "热水器水温这两天稳了，师傅换的温控阀起了作用", "subject": "HER", "relation": "房屋维修", "evidence_uids": [9], "evidence_quotes": ["热水器这两天水温稳了，师傅换的那个温控阀没白换"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-15 10:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 10:28", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "房东前天遛弯时提到想续约到明年三月", "subject": "HER", "relation": "租约", "evidence_uids": [9], "evidence_quotes": ["房东前天遛弯碰上我，提了句想续约到明年三月"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13", "valid_from": "2026-11-15 10:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 10:28", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "续约到明年三月，等她拿主意，不急着今天定", "subject": "UNKNOWN", "relation": "", "evidence_uids": [9, 11], "evidence_quotes": ["你拿个主意，不急着今天", "续约我定了，续到明年三月"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-15 10:28", "valid_to": "2026-11-18 20:12", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 10:28", "history": [{"status": "proposed", "text": "续约到明年三月，等她拿主意，不急着今天定", "valid_to": "2026-11-18 20:12", "reason": "complete", "src_uids": [11], "quote": "续约我定了，续到明年三月"}]}, "f_0033": {"fact_id": "f_0033", "text": "她口算 48 加 17 得 56", "subject": "HER", "relation": "账目", "evidence_uids": [10], "evidence_quotes": ["我口算出来是 56"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16 21:10", "valid_from": "2026-11-16 21:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 21:18", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "她忘了是否已收到转账", "subject": "HER", "relation": "账目", "evidence_uids": [10], "evidence_quotes": ["你转了没我忘了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16 21:10", "valid_from": "2026-11-16 21:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 21:18", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "续约已定，续到明年三月", "subject": "HER", "relation": "租房续约", "evidence_uids": [11], "evidence_quotes": ["续约我定了，续到明年三月"], "certainty": "confirmed", "status": "confirmed", "event_time": "到明年三月", "valid_from": "2026-11-18 20:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 20:12", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "续约后水费房东承担，电费网费仍由两人分摊", "subject": "SHARED", "relation": "费用分摊", "evidence_uids": [11], "evidence_quotes": ["房东说续约以后水费他包，电费网费还是咱俩摊"], "certainty": "confirmed", "status": "confirmed", "event_time": "续约后", "valid_from": "2026-11-18 20:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 20:12", "history": 