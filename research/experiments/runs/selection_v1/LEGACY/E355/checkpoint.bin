"f_0001", "text": "车前子，每天清晨在小区健身角拉引体，懂运动防护，给老庾等几位邻居调过发力姿势，说话省字。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "蒋星晚，大学时打过排球，右膝有旧伤，十月起练五公里，报了元旦社区迎新跑，住三栋，常在健身角夜练。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "健身角点头之交处成了熟络，她给他带过绿豆汤，他提醒过她落地姿势，都记在心里没挂嘴上。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "蒋星晚嘴硬，难受的时候反而把话说得轻，用开玩笑往回找补。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "车前子，晨练雷打不动、懂运动防护、说话省字", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "蒋星晚，嘴硬、不服输、难受时把话说得轻，底线：不接受怜悯式关心、自己的节奏自己定", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "她报了元旦社区迎新跑五公里", "subject": "HER", "relation": "赛事报名", "evidence_uids": [0], "evidence_quotes": ["元旦社区迎新跑，我报了五公里"], "certainty": "confirmed", "status": "confirmed", "event_time": "2027-01-01", "valid_from": "2026-11-02 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-02 07:38", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "她从今天起加量训练", "subject": "HER", "relation": "训练安排", "evidence_uids": [0], "evidence_quotes": ["从今天起加量"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-02", "valid_from": "2026-11-02 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-02 07:38", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "今早单杠被我占了二十分钟", "subject": "ME", "relation": "健身角", "evidence_uids": [0], "evidence_quotes": ["今早单杠你足足占了二十分钟"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-02 早晨", "valid_from": "2026-11-02 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-02 07:38", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "她要求配速难看时不许笑", "subject": "HER", "relation": "约定", "evidence_uids": [0], "evidence_quotes": ["配速要是难看，不许笑"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-02 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-02 07:38", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "第三天跑，四公里处膝盖外侧开始疼", "subject": "HER", "relation": "训练状况", "evidence_uids": [1], "evidence_quotes": ["第三天，四公里处膝盖外侧开始抗议"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04", "valid_from": "2026-11-04 07:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-04 07:27", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她降速走跑结合撑完，配速七分半", "subject": "HER", "relation": "训练状况", "evidence_uids": [1], "evidence_quotes": ["我按你上回说的降速，走跑结合撑完了，配速七分半"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04", "valid_from": "2026-11-04 07:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-04 07:27", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她今天跑了八公里，膝盖不适，下楼都打软", "subject": "HER", "relation": "训练状态", "evidence_uids": [2], "evidence_quotes": ["今天八公里，拉爆了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07", "valid_from": "2026-11-07 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 19:47", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "她挂了周一上午的运动医学科", "subject": "HER", "relation": "就医安排", "evidence_uids": [2], "evidence_quotes": ["我挂了周一上午的运动医学科"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 上午", "valid_from": "2026-11-07 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 19:47", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "她在考虑退掉元旦迎新跑的报名（尚未决定）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [2, 11], "evidence_quotes": ["要不元旦那个报名退了算了？", "元旦那天我不跑了，报名了五公里处的补给站志愿者"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-07 19:47", "valid_to": "2026-11-24 07:28", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 19:47", "history": [{"status": "proposed", "text": "她在考虑退掉元旦迎新跑的报名（尚未决定）", "valid_to": "2026-11-24 07:28", "reason": "complete", "src_uids": [11], "quote": "元旦那天我不跑了，报名了五公里处的补给站志愿者"}]}, "f_0016": {"fact_id": "f_0016", "text": "她看了运动医学科，诊断是髂胫束摩擦综合征，医生给的是休息、降量、练臀", "subject": "HER", "relation": "身体状况/就诊结果", "evidence_uids": [3], "evidence_quotes": ["髂胫束摩擦综合征。医生就给三个词：休息，降量，练臀。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 上午", "valid_from": "2026-11-09 12:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 12:18", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她问医生多久能跑，医生说因人而异；问元旦前能不能跑，医生笑而不答", "subject": "HER", "relation": "就诊经过", "evidence_uids": [3], "evidence_quotes": ["我问多久能跑，他说因人而异；我问元旦前行不行，他笑而不答。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 上午", "valid_from": "2026-11-09 12:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 12:18", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她今早到健身角没跑，用我的单杠做了三个引体", "subject": "HER", "relation": "晨练", "evidence_uids": [4], "evidence_quotes": ["今早照旧到了健身角，没跑。把你的引体让给我做了三个"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 早上", "valid_from": "2026-11-10 07:23", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 07:23", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "她表示膝盖的事自己心里有数，不用我惦记", "subject": "HER", "relation": "膝盖旧伤", "evidence_uids": [4], "evidence_quotes": ["膝盖的事我心里有数，不用你惦记"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 07:23", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 07:23", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "她晚上路过体育馆，在台阶上坐了二十分钟", "subject": "HER", "relation": "当晚经历", "evidence_uids": [5], "evidence_quotes": ["我在台阶上坐了二十分钟"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 晚", "valid_from": "2026-11-11 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:42", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "五年前伤的是这条腿，那年是省队选拔", "subject": "HER", "relation": "旧伤来历", "evidence_uids": [5], "evidence_quotes": ["五年前伤的就是这条腿，那年省队选拔"], "certainty": "confirmed", "status": "confirmed", "event_time": "五年前", "valid_from": "2026-11-11 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:42", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "她今晚一口酒没喝", "subject": "HER", "relation": "状态", "evidence_uids": [6], "evidence_quotes": ["其实一口没喝"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 晚", "valid_from": "2026-11-11 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:42", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "她要求这两天别问她膝盖的事", "subject": "HER", "relation": "边界", "evidence_uids": [7], "evidence_quotes": ["这两天别问我膝盖的事"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12起两天内", "valid_from": "2026-11-12 07:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 07:47", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "她练臀的计划自己排了，周四周六各一次", "subject": "HER", "relation": "训练安排", "evidence_uids": [7], "evidence_quotes": ["练臀的计划我自己排了，周四周六各一次"], "certainty": "confirmed", "status": "confirmed", "event_time": "每周四、周六", "valid_from": "2026-11-12 07:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 07:47", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "退不退元旦迎新跑报名，她月底前给答案", "subject": "HER", "relation": "待定事项", "evidence_uids": [7, 12], "evidence_quotes": ["退不退报名，月底前我给答案", "月底了，答案给你：报名不退，我上补给站。"], "certainty": "confirmed", "status": "completed", "event_time": "2026-11月底前", "valid_from": "2026-11-12 07:47", "valid_to": "2026-11-30 22:02", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 07:47", "history": [{"status": "confirmed", "text": "退不退元旦迎新跑报名，她月底前给答案", "valid_to": "2026-11-30 22:02", "reason": "complete", "src_uids": [12], "quote": "月底了，答案给你：报名不退，我上补给站。"}]}, "f_0026": {"fact_id": "f_0026", "text": "退不退元旦迎新跑报名，月底前给答案（未敲定）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7, 11], "evidence_quotes": ["退不退报名，月底前我给答案", "元旦那天我不跑了，报名了五公里处的补给站志愿者"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-12 07:47", "valid_to": "2026-11-24 07:28", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 07:47", "history": [{"status": "proposed", "text": "退不退元旦迎新跑报名，月底前给答案（未敲定）", "valid_to": "2026-11-24 07:28", "reason": "complete", "src_uids": [11], "quote": "元旦那天我不跑了，报名了五公里处的补给站志愿者"}]}, "f_0027": {"fact_id": "f_0027", "text": "她今天练完臀，加了两片杠铃片", "subject": "HER", "relation": "训练", "evidence_uids": [8], "evidence_quotes": ["今天练完臀，加了两片杠铃片"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 早上", "valid_from": "2026-11-14 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 07:38", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "她的六周训练计划已排好，十二月二十前后试慢跑", "subject": "HER", "relation": "训练计划", "evidence_uids": [8], "evidence_quotes": ["六周计划排好了，十二月二十前后试慢跑"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-12-20前后", "valid_from": "2026-11-14 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 07:38", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "元旦迎新跑报名费八十块", "subject": "HER", "relation": "报名", "evidence_uids": [8], "evidence_quotes": ["报名费八十块"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 07:38", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "十二月二十前后试慢跑，行不行到时候见分晓", "subject": "UNKNOWN", "relation": "", "evidence_uids": [8], "evidence_quotes": ["十二月二十前后试慢跑，行不行到时候见分晓"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 07:38", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "她周六上午九点约了康复科的运动评估，说自己能去", "subject": "HER", "relation": "就医安排", "evidence_uids": [9], "evidence_quotes": ["周六上午九点，康复科约了个运动评估，我自己能去"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21 上午九点", "valid_from": "2026-11-17 19:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 19:58", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "她评估完直接回小区，让我十一点前后在健身角示范臀桥", "subject": "HER", "relation": "请求", "evidence_uids": [9], "evidence_quotes": ["评估完我直接回小区，你十一点前后要是路过健身角，耽误你一分钟：臀桥我总做不对，你照老庾那套给我示范一遍就行"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21 上午十一点前后", "valid_from": "2026-11-17 19:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 19:58", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "她说臀桥总做不对", "subject": "HER", "relation": "身体状态", "evidence_uids": [9], "evidence_quotes": ["臀桥我总做不对"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-17 19:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 19:58", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "她要把评估报告拍给我，让我看替代动作那段", "subject": "HER", "relation": "请求", "evidence_uids": [9, 10], "evidence_quotes": ["评估报告我拍给你，你帮我看替代动作那段", "报告拍你了，别整页看，就看第三页红笔标的那条。"], "certainty": "confirmed", "status": "completed", "event_time": "", "valid_from": "2026-11-17 19:58", "valid_to": "2026-11-21 11:18", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 19:58", "history": [{"status": "confirmed", "text": "她要把评估报告拍给我，让我看替代动作那段", "valid_to": "2026-11-21 11:18", "reason": "complete", "src_uids": [10], "quote": "报告拍你了，别整页看，就看第三页红笔标的那条。"}]}, "f_0035": {"fact_id": "f_0035", "text": "她今天做完了运动评估", "subject": "HER", "relation": "康复评估", "evidence_uids": [10], "evidence_quotes": ["评估做完了。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21 上午", "valid_from": "2026-11-21 11:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 11:18", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "治疗师说她臀中肌“在装睡”，激活动作练两周能唤醒", "subject": "HER", "relation": "评估结论", "evidence_uids": [10], "evidence_quotes": ["治疗师说我臀中肌在装睡，激活动作练两周能唤醒它。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21 上午", "valid_from": "2026-11-21 11:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 11:18", "history": []}, "f_0037": {"fact_id": "f_0037", "text": "她说评估报告已拍给我，让我只看第三页红笔标的那条", "subject": "HER", "relation": "报告", "evidence_uids": [10], "evidence_quotes": ["报告拍你了，别整页看，就看第三页红笔标的那条。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21 11:10", "valid_from": "2026-11-21 11:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 11:18", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "她改的降阶版昨天头一回无痛做完", "subject": "HER", "relation": "康复训练进展", "evidence_uids": [11], "evidence_quotes": ["你改的降阶版昨天头一回无痛做完"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-23", "valid_from": "2026-11-24 07:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 07:28", "history": []}, "f_0039": {"fact_id": "f_0039", "text": "她决定元旦不跑，改报五公里处补给站志愿者，位置自己挑的", "subject": "HER", "relation": "元旦安排", "evidence_uids": [11], "evidence_quotes": ["元旦那天我不跑了，报名了五公里处的补给站志愿者"], "certainty": "confirmed", "status": "confirmed", "event_time": "2027-01-01", "valid_from": "2026-11-24 07:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 07:28", "history": []}, "f_0040": {"fact_id": "f_0040", "text": "她决定不退元旦迎新跑报名，元旦当天到五公里处的补给站当志愿者", "subject": "HER", "relation": "元旦迎新跑安排", "evidence_uids": [12], "evidence_quotes": ["月底了，答案给你：报名不退，我上补给站。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2027-01-01 元旦", "valid_from": "2026-11-30 22:02", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 22:02", "history": []}, "f_0041": {"fact_id": "f_0041", "text": "她提出十二月周六早上在健身角加一个“臀桥角”，由她来教，条件是我每场去站一分钟", "subject": "HER", "relation": "健身角安排提议", "evidence_uids": [12], "evidence_quotes": ["另外十二月健身角周六早上加个‘臀桥角’，我来教，学费是每场你来站一分钟。"], "certainty": "tentative", "status": "tentative", "event_time": "2026-12 每周六早上", "valid_from": "2026-11-30 22:02", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 22:02", "history": []}, "f_0042": {"fact_id": "f_0042", "text": "十二月周六早上健身角“臀桥角”，她来教，我每场站一分钟（我尚未回应）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [12], "evidence_quotes": ["另外十二月健身角周六早上加个‘臀桥角’，我来教，学费是每场你来站一分钟。"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-30 22:02", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 22:02", "history": []}}, "fact_seq": 42, "updates": [{"fact_id": "f_0034", "action": "complete", "text": "她要把评估报告拍给我，让我看替代动作那段", "old_text": "她要把评估报告拍给我，让我看替代动作那段", "ts": "2026-11-21 11:18", "src_uids": [10], "quote": "报告拍你了，别整页看，就看第三页红笔标的那条。"}, {"fact_id": "f_0026", "action": "complete", "text": "退不退元旦迎新跑报名，月底前给答案（未敲定）", "old_text": "退不退元旦迎新跑报名，月底前给答案（未敲定）", "ts": "2026-11-24 07:28", "src_uids": [11], "quote": "元旦那天我不跑了，报名了五公里处的补给站志愿者"}, {"fact_id": "f_0015", "action": "complete", "text": "她在考虑退掉元旦迎新跑的报名（尚未决定）", "old_text": "她在考虑退掉元旦迎新跑的报名（尚未决定）", "ts": "2026-11-24 07:28", "src_uids": [11], "quote": "元旦那天我不跑了，报名了五公里处的补给站志愿者"}, {"fact_id": "f_0025", "action": "complete", "text": "退不退元旦迎新跑报名，她月底前给答案", "old_text": "退不退元旦迎新跑报名，她月底前给答案", "ts": "2026-11-30 22:02", "src_uids": [12], "quote": "月底了，答案给你：报名不退，我上补给站。"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", 