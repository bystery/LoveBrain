": "reported", "plan_status": "", "ts": "2026-11-15 10:37", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "桥上风大，回程整段逆风；她的结论是能骑，但新人会觉得长", "subject": "HER", "relation": "路线实测", "evidence_uids": [5], "evidence_quotes": ["桥上风大，回程整段逆风。结论：能骑，但新人会觉得长"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-15 10:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 10:37", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "老桑让她出新河堤线的正式通知", "subject": "THIRD", "relation": "团内安排", "evidence_uids": [5], "evidence_quotes": ["老桑让我出正式通知"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-15 10:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 10:37", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "她想把新河堤线的日子定在下周日", "subject": "UNKNOWN", "relation": "", "evidence_uids": [5, 6], "evidence_quotes": ["我想把日子定在下周日", "通知发了：22号周日14:00，河堤东口集合"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-15 10:37", "valid_to": "2026-11-16 21:22", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 10:37", "history": [{"status": "proposed", "text": "她想把新河堤线的日子定在下周日", "valid_to": "2026-11-16 21:22", "reason": "complete", "src_uids": [6], "quote": "通知发了：22号周日14:00，河堤东口集合"}]}, "f_0029": {"fact_id": "f_0029", "text": "她发了通知：22号周日14:00河堤东口集合，34.7公里休闲骑，限12人，报名费15块含补给", "subject": "HER", "relation": "活动通知", "evidence_uids": [6], "evidence_quotes": ["通知发了：22号周日14:00，河堤东口集合，34.7公里休闲骑，限12人，报名费15块含补给。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22 14:00", "valid_from": "2026-11-16 21:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 21:22", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "探过线的一组要帮新人驮补给", "subject": "HER", "relation": "分工安排", "evidenc