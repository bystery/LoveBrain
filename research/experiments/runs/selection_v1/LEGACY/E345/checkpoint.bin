persedes": "", "origin": "kbin:me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "时安蕾是店里兼职DM，本龄六年，店长老利管排期和会员日，车友阿荞、小莼爱起哄，新申请入队的是阿莞。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "同车队一年多，她给他留过角色，他给她带过夜宵，玩笑开了一箩筐，正话没说过一句。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "她惯用DM腔把正事说成主持词；他接她的玩笑只接一层，从不顺着起哄走。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "封野青，固定车队的玩家，逻辑流、复盘写小作文、被起哄时不动声色", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "时安蕾，剧本杀店兼职DM，本龄六年、复盘爱写小论文、玩笑开得快，收得也快，底线：不开着角色讲私事、不拿玩家的糗事当公开梗", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "她问周三《雾岛》场缺法医，我来不来", "subject": "HER", "relation": "邀约", "evidence_uids": [0], "evidence_quotes": ["周三《雾岛》的场小莼放鸽子了，缺个法医，你来不来？"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04 19:00", "valid_from": "2026-11-02 20:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-02 20:48", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "周三《雾岛》场提前到六点半开场，她留我惯坐的角落位，我六点二十前到", "subject": "HER", "relation": "场次安排", "evidence_uids": [0, 2], "evidence_quotes": ["开场七点，你六点五十前到，我给你留你惯坐的角落位。", "周三那场提前到六点半，老利要清场办会员日，你六点二十前到。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04 19:00", "valid_from": "2026-11-03 21:23", "valid_to": "", "supersedes": "f_0008@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-02 20:48", "history": [{"status": "confirmed", "text": "开场七点，六点五十前到，她留我惯坐的角落位", "valid_to": "2026-11-03 21:23", "reason": "correct", "src_uids": [2], "quote": "周三那场提前到六点半，老利要清场办会员日，你六点二十前到。"}]}, "f_0009": {"fact_id": "f_0009", "text": "她把封野青上回复盘里“雾是从第二幕起雾的”那句抄进了DM手记本", "subject": "HER", "relation": "DM手记本", "evidence_uids": [1], "evidence_quotes": ["你上回复盘写的那段'雾是从第二幕起雾的'，我抄进DM手记本了"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-03 12:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-03 12:37", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "阿荞评价封野青的复盘写得比谁都好、比谁都长", "subject": "THIRD", "relation": "车友", "evidence_uids": [1], "evidence_quotes": ["阿荞说比你写得好的没有，比你写得长的也不多"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-03 12:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-03 12:37", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "周三《雾岛》场提前到六点半开场，我六点二十前到", "subject": "SHARED", "relation": "约定", "evidence_uids": [2], "evidence_quotes": ["周三那场提前到六点半，老利要清场办会员日，你六点二十前到。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04 18:30", "valid_from": "2026-11-03 21:23", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-03 21:23", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她重写了一段开场白，想让我听听成不成", "subject": "HER", "relation": "剧本杀场务", "evidence_uids": [2], "evidence_quotes": ["开场白我重写了一段，比上回那个顺——你来听听成不成。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04", "valid_from": "2026-11-03 21:23", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-03 21:23", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她把“法医封野青，场场必中”记进了DM手记", "subject": "HER", "relation": "DM手记", "evidence_uids": [3], "evidence_quotes": ["DM手记我记了一笔：'法医封野青，场场必中'"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04", "valid_from": "2026-11-04 23:09", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-04 23:09", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "封野青的法医白大褂落在更衣间，她先收着", "subject": "HER", "relation": "随身物品", "evidence_uids": [3], "evidence_quotes": ["你那件法医白大褂落在更衣间，我先收着"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-04", "valid_from": "2026-11-04 23:09", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-04 23:09", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "阿荞要请喝可乐，两瓶", "subject": "UNKNOWN", "relation": "", "evidence_uids": [3], "evidence_quotes": ["阿荞说要请你喝可乐，我说行，他可乐瘾大，买两瓶"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-04 23:09", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-04 23:09", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "《雾岛2》定档下周三，开场六点半", "subject": "HER", "relation": "场次安排", "evidence_uids": [4], "evidence_quotes": ["《雾岛2》定档下周三，还是六点半"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 18:30", "valid_from": "2026-11-06 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-06 19:47", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "阿莞申请进车队，本龄三年，老利说她挺稳", "subject": "HER", "relation": "新成员申请", "evidence_uids": [4], "evidence_quotes": ["店里新申请进车的玩家叫阿莞，本龄三年，老利说挺稳"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-06 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-06 19:47", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她下午在店里试《雾岛2》的凶器道具，缺个试玩的，约我三点去，就我们俩", "subject": "HER", "relation": "邀约", "evidence_uids": [5], "evidence_quotes": ["我下午在店里试《雾岛2》的凶器道具，缺个试玩的。你要是没安排，三点来，就我们俩"], "certainty": "tentative", "status": "tentative", "event_time": "2026-11-08 15:00", "valid_from": "2026-11-08 10:39", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 10:39", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "阿荞她们都看展去了", "subject": "THIRD", "relation": "行程", "evidence_uids": [5], "evidence_quotes": ["阿荞她们都看展去了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-08", "valid_from": "2026-11-08 10:39", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 10:39", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "下午三点去店里试玩《雾岛2》凶器道具，就两人", "subject": "UNKNOWN", "relation": "", "evidence_uids": [5], "evidence_quotes": ["你要是没安排，三点来，就我们俩"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-08 10:39", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 10:39", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "周三让我坐她斜对面，因为对面的灯坏了晃眼", "subject": "HER", "relation": "座位安排", "evidence_uids": [6], "evidence_quotes": ["周三你坐我斜对面，别坐对面——对面的灯坏了，晃眼。"], "certainty": "confirmed", "status": "confirmed", "event_time": "周三", "valid_from": "2026-11-09 10:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 10:26", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "老利说店赛我不去可惜", "subject": "THIRD", "relation": "转述", "evidence_uids": [6], "evidence_quotes": ["他说店赛你要是不去可惜了"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-09 10:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 10:26", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "首车成了，全车只有我和小莼俩人写小作文", "subject": "HER", "relation": "车队近况", "evidence_uids": [7], "evidence_quotes": ["首车成了，全车就你和小莼俩人写小作文"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-11 23:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 23:27", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "老利说这局我是MVP，奖励免单一局", "subject": "THIRD", "relation": "店赛奖励", "evidence_uids": [7], "evidence_quotes": ["老利说这局你是MVP，奖励免单一局"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-11 23:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 23:27", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "这个月底店里搞周年场", "subject": "HER", "relation": "店铺活动", "evidence_uids": [7], "evidence_quotes": ["这个月底店里搞周年场"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11月底", "valid_from": "2026-11-11 23:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 23:27", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "她想开一个就我们俩的双人本，五个钟头", "subject": "HER", "relation": "邀约意向", "evidence_uids": [7], "evidence_quotes": ["我想开个双人本，就我们俩那种，五个钟头"], "certainty": "tentative", "status": "tentative", "event_time": "2026-11月底", "valid_from": "2026-11-11 23:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 23:27", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "周年场双人本定在11月28号周六，老利点名她主持，玩家名额一个，她留给我", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7, 9], "evidence_quotes": ["我想开个双人本，就我们俩那种，五个钟头", "档期问好了，周年场定在11月28号周六"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 21:47", "valid_to": "", "supersedes": "f_0027@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-11 23:27", "history": [{"status": "proposed", "text": "月底周年场开双人本，就我们俩，五个钟头（具体日期未定）", "valid_to": "2026-11-13 21:47", "reason": "correct", "src_uids": [9], "quote": "档期问好了，周年场定在11月28号周六"}]}, "f_0028": {"fact_id": "f_0028", "text": "她让我别急着答双人本的事，她先去问店里档期", "subject": "HER", "relation": "双人本安排", "evidence_uids": [8], "evidence_quotes": ["双人本的事你别急着答，我先去问店里档期。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-12 09:16", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 09:16", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "她让我周三免单那局带上阿莞，说她首车没人带容易慌", "subject": "HER", "relation": "周三场安排", "evidence_uids": [8], "evidence_quotes": ["周三免单那局记得带上阿莞，她首车没人带容易慌。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 周三", "valid_from": "2026-11-12 09:16", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 09:16", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "她先去问店里双人本的档期，问完再说", "subject": "UNKNOWN", "relation": "", "evidence_uids": [8, 10], "evidence_quotes": ["我先去问店里档期", "28号前还剩两个周三"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-12 09:16", "valid_to": "2026-11-15 16:12", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 09:16", "history": [{"status": "proposed", "text": "她先去问店里双人本的档期，问完再说", "valid_to": "2026-11-15 16:12", "reason": "complete", "src_uids": [10], "quote": "28号前还剩两个周三"}]}, "f_0031": {"fact_id": "f_0031", "text": "周年场定在11月28号周六", "subject": "HER", "relation": "周年场档期", "evidence_uids": [9], "evidence_quotes": ["周年场定在11月28号周六"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-28 周六", "valid_from": "2026-11-13 21:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:47", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "双人本老利点名让她主持，玩家名额只有一个，她留给我", "subject": "HER", "relation": "双人本名额", "evidence_uids": [9], "evidence_quotes": ["双人本老利点名让我主持，玩家名额就一个，我给你留着"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-28 周六", "valid_from": "2026-11-13 21:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:47", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "周三免单那局我请了全车奶茶，她那杯没加珍珠", "subject": "HER", "relation": "奶茶细节", "evidence_uids": [9], "evidence_quotes": ["周三免单那局你请的全车奶茶，就我那杯没加珍珠"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 周三", "valid_from": "2026-11-13 21:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:47", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "她说双人本的复盘大纲写了一半", "subject": "HER", "relation": "双人本准备", "evidence_uids": [10], "evidence_quotes": ["双人本的复盘大纲我写了一半"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-15 16:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 16:12", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "她把我的角色背景发到了我邮箱", "subject": "HER", "relation": "双人本准备", "evidence_uids": [10], "evidence_quotes": ["你的角色背景发你邮箱了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-15 16:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 16:12", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "28号前还剩两个周三", "subject": "HER", "relation": "档期", "evidence_uids": [10], "evidence_quotes": ["28号前还剩两个周三"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-15 16:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 16:12", "history": []}, "f_0037": {"fact_id": "f_0037", "text": "她说我缺哪场就说一声，她给我留角色", "subject": "HER", "relation": "留角色", "evidence_uids": [10], "evidence_quotes": ["你缺哪场说一声，我给你留角色"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-15 16:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 16:12", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "我说哪场缺，她给我留角色（还没定哪一场）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [10], "evidence_quotes": ["你缺哪场说一声，我给你留角色"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-15 16:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-15 16:12", "history": []}, "f_0039": {"fact_id": "f_0039", "text": "她说双人本大纲写完了", "subject": "HER", "relation": "双人本进度", "evidence_uids": [11], "evidence_quotes": ["大纲写完了。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-17 22:19", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 22:19", "history": []}, "f_0040": {"fact_id": "f_0040", "text": "她说28号那场结局改了一版，老利说没看懂", "subject": "HER", "relation": "双人本结局", "evidence_uids": [11], "evidence_quotes": ["28号那场的结局我改了一版，老利说没看懂"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-28", "valid_from": "2026-11-17 22:19", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 22:19", "history": []}, "f_0041": {"fact_id": "f_0041", "text": "她让我周三来", "subject": "HER", "relation": "约场", "evidence_uids": [11], "evidence_quotes": ["周三记得来"], "certainty": "confirmed", "status": "confirmed", "event_time": "周三", "valid_from": "2026-11-17 22:19", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 22:19", "history": []}, "f_0042": {"fact_id": "f_0042", "text": "她说白大褂洗好挂在店里储物柜，柜子密码是我生日那组数", "subject": "HER", "relation": "白大褂", "evidence_uids": [11], "evidence_quotes": ["你的白大褂我洗好了，挂在店里储物柜，柜子密码是你生日那组数"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-17 22:19", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 22:19", "history": []}}, "fact_seq": 42, "updates": [{"fact_id": "f_0008", "action": "correct", "text": "周三《雾岛》场提前到六点半开场，她留我惯坐的角落位，我六点二十前到", "old_text": "开场七点，六点五十前到，她留我惯坐的角落位", "ts": "2026-11-03 21:23", "src_uids": [2], "quote": "周三那场提前到六点半，老利要清场办会员日，你六点二十前到。"}, {"fact_id": "f_0027", "action": "correct", "text": "周年场双人本定在11月28号周六，老利点名她主持，玩家名额一个，她留给我", "old_text": "月底周年场开双人本，就我们俩，五个钟头（具体日期未定）", "ts": "2026-11-13 21:47", "src_uids": [9], "quote": "档期问好了，周年场定在11月28号周六"}, {"fact_id": "f_0030", "action": "complete", "text": "她先去问店里双人本的档期，问完再说", "old_text": "她先去问店里双人本的档期，问完再说", "ts": "2026-11-15 16:12", "src_uids": [10], "quote": "28号前还剩两个周三"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}