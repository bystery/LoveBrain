er": true, "evidence_memory": true}, "mem": {"facts": {"f_0001": {"fact_id": "f_0001", "text": "常青野，宠物寄养互助群元老，接代喂的班排得最稳，家养橘猫一只，住本小区七栋，周末上午常在小区花园跑步。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "齐鹿鸣，养十五岁的猫灰灰，慢性肾病需早晚喂药；十一月起帮邻居阿荞代养柯基年糕半月；母亲在邻省，十一月赴复查。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "群里互相代喂两年，她记得他随口提过的忌口，他记得她猫的用药时间，重话从没有过。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "齐鹿鸣报忧先报喜，情绪一上来就转事务话题，越难受越列清单。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "常青野，宠物寄养互助群元老、代喂排班从没乱过、话不多但稳", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "齐鹿鸣，清单控、嘴硬报喜不报忧、对猫对人都上心，底线：不接受硬塞的安慰、自己的事自己扛", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "她周五一早送母亲去邻省复查，陪住一晚，周日中午前回来", "subject": "HER", "relation": "行程", "evidence_uids": [0], "evidence_quotes": ["周五一早我送我妈去邻省复查，陪她住一晚，周日中午前回来"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-06 至 2026-11-08 中午前", "valid_from": "2026-11-05 09:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-05 09:17", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "周五晚到周日早由我代喂灰灰的药，一天两次，早七点半晚七点半，拌在罐头里", "subject": "SHARED", "relation": "代喂安排", "evidence_uids": [0], "evidence_quotes": ["周五晚到周日早，灰灰的药得劳驾你来喂：一天两次，早七点半晚七点半，都拌在罐头里"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-06 晚 至 2026-11-08 早", "valid_from": "2026-11-05 09:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-05 09:17", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "报酬按群规矩，一杯豆浆加猫毛若干", "subject": "HER", "relation": "玩笑式报酬", "evidence_uids": [0], "evidence_quotes": ["报酬按群规矩：一杯豆浆，外加猫毛若干"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-05 09:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-05 09:17", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "年糕刚吐了，吐的是没消化的粮", "subject": "HER", "relation": "她的代养柯基", "evidence_uids": [1], "evidence_quotes": ["年糕刚吐了，吐的是没消化的粮"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-05 深夜", "valid_from": "2026-11-05 23:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-05 23:38", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "查了半宿，说多半是换粮应激", "subject": "HER", "relation": "年糕的状况", "evidence_uids": [1], "evidence_quotes": ["查了半宿，说多半是换粮应激"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-05 深夜", "valid_from": "2026-11-05 23:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-05 23:38", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "阿荞电话打不通，她在高铁上", "subject": "THIRD", "relation": "邻居阿荞", "evidence_uids": [1], "evidence_quotes": ["阿荞电话打不通，她在高铁上"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-05 23:30", "valid_from": "2026-11-05 23:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-05 23:38", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她让我明天喂灰灰照旧", "subject": "HER", "relation": "喂药安排", "evidence_uids": [1], "evidence_quotes": ["你明天喂灰灰照旧，别分心"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-06", "valid_from": "2026-11-05 23:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-05 23:38", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "灰灰的药分成四盒，早蓝晚绿，放在冰箱门第二层", "subject": "HER", "relation": "灰灰用药安排", "evidence_uids": [2], "evidence_quotes": ["灰灰的药我分了四盒，早蓝晚绿，在冰箱门第二层"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-06 起", "valid_from": "2026-11-06 07:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-06 07:48", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "灰灰的罐头只吃鱼的那款，其他口味不硬喂", "subject": "HER", "relation": "灰灰饮食", "evidence_uids": [2], "evidence_quotes": ["罐头只吃鱼的那款，别的口味放着别硬喂"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-06 07:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-06 07:48", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "年糕的粮在阳台柜，一天两把，不加餐", "subject": "HER", "relation": "年糕喂养", "evidence_uids": [2], "evidence_quotes": ["年糕的粮在阳台柜，一天两把，它要是围着你转，别惯着加餐"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-06 07:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-06 07:48", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她母亲这次复查结果不太好，是需要长期管着的那种", "subject": "HER", "relation": "家人健康", "evidence_uids": [3], "evidence_quotes": ["我妈这次复查，结果不太好"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-08", "valid_from": "2026-11-08 23:59", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 23:59", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "灰灰十五岁", "subject": "HER", "relation": "宠物", "evidence_uids": [3], "evidence_quotes": ["灰灰也十五了"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-08 23:59", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 23:59", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "年糕便便成型了", "subject": "HER", "relation": "代养的柯基", "evidence_uids": [4], "evidence_quotes": ["年糕便便成型了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 08:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 08:26", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "她妈这周四约了专科复诊，她陪", "subject": "HER", "relation": "母亲复查", "evidence_uids": [4, 8], "evidence_quotes": ["我妈这周四约了专科复诊，我陪", "我妈周四看完了专科"], "certainty": "confirmed", "status": "completed", "event_time": "2026-11-12", "valid_from": "2026-11-09 08:26", "valid_to": "2026-11-14 10:22", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 08:26", "history": [{"status": "confirmed", "text": "她妈这周四约了专科复诊，她陪", "valid_to": "2026-11-14 10:22", "reason": "complete", "src_uids": [8], "quote": "我妈周四看完了专科"}]}, "f_0021": {"fact_id": "f_0021", "text": "喂药时若发现灰灰左眼分泌物变多，拍照发她，不要自己上手", "subject": "HER", "relation": "灰灰用药观察", "evidence_uids": [4], "evidence_quotes": ["你喂药要是发现灰灰左眼分泌物变多，拍照发我，别自己上手，它挠人"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-09 08:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 08:26", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "她昨晚睡了四个钟头", "subject": "HER", "relation": "睡眠", "evidence_uids": [4], "evidence_quotes": ["昨晚睡了四个钟头，居然不困"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-08 夜", "valid_from": "2026-11-09 08:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 08:26", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "阿荞回来了", "subject": "THIRD", "relation": "邻居/年糕主人", "evidence_uids": [5], "evidence_quotes": ["阿荞回来了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:47", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "阿荞进门第一句说年糕瘦了", "subject": "THIRD", "relation": "邻居/年糕主人", "evidence_uids": [5], "evidence_quotes": ["进门第一句：年糕怎么瘦了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:47", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她把换粮的量减了半把", "subject": "HER", "relation": "代养年糕", "evidence_uids": [5], "evidence_quotes": ["换粮的量我减了半把"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:47", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "她把喂养记录表发到群里了", "subject": "HER", "relation": "代养年糕", "evidence_uids": [5], "evidence_quotes": ["记录表发群里了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:47", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "她五天做了两页喂养记录、三十张照片", "subject": "HER", "relation": "代养年糕", "evidence_uids": [5], "evidence_quotes": ["我五天两页喂养记录三十张照片"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-05至2026-11-10", "valid_from": "2026-11-10 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:47", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "她这两天让群里的事直接找阿荞，别找她", "subject": "HER", "relation": "安排", "evidence_uids": [6], "evidence_quotes": ["这两天群里的事你直接找阿荞，别找我"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11起这两天", "valid_from": "2026-11-11 21:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:57", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "她妈周四的专科号挂上了", "subject": "HER", "relation": "家人就医", "evidence_uids": [6, 8], "evidence_quotes": ["我妈周四的专科号挂上了，谢了", "我妈周四看完了专科"], "certainty": "confirmed", "status": "completed", "event_time": "2026-11-12周四", "valid_from": "2026-11-11 21:57", "valid_to": "2026-11-14 10:22", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:57", "history": [{"status": "confirmed", "text": "她妈周四的专科号挂上了", "valid_to": "2026-11-14 10:22", "reason": "complete", "src_uids": [8], "quote": "我妈周四看完了专科"}]}, "f_0030": {"fact_id": "f_0030", "text": "手机充电后再说", "subject": "UNKNOWN", "relation": "", "evidence_uids": [6, 7], "evidence_quotes": ["没生气，就是电用完了，充上再说", "电充上了。"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-11 21:57", "valid_to": "2026-11-13 18:37", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:57", "history": [{"status": "proposed", "text": "手机充电后再说", "valid_to": "2026-11-13 18:37", "reason": "complete", "src_uids": [7], "quote": "电充上了。"}]}, "f_0031": {"fact_id": "f_0031", "text": "她说豆浆今天放在驿站，取件码微信发我", "subject": "HER", "relation": "报酬", "evidence_uids": [7], "evidence_quotes": ["豆浆今天放驿站了，取件码微信发你。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13", "valid_from": "2026-11-13 18:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:37", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "灰灰这两天精神头回来了", "subject": "HER", "relation": "猫的状态", "evidence_uids": [7], "evidence_quotes": ["灰灰这两天精神头回来了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13", "valid_from": "2026-11-13 18:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:37", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "早蓝晚绿的分装盒规矩她留着，下个月复查周接着用", "subject": "HER", "relation": "喂药安排", "evidence_uids": [7], "evidence_quotes": ["分装盒早蓝晚绿的规矩我留着，下个月复查周接着用。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13", "valid_from": "2026-11-13 18:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:37", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "下个月复查周继续用早蓝晚绿分装盒（具体日期未定）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7], "evidence_quotes": ["下个月复查周接着用"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-13 18:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:37", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "她妈周四看完了专科，方案是先吃药观察三个月，一月底再复查", "subject": "HER", "relation": "母亲病情", "evidence_uids": [8], "evidence_quotes": ["方案是先吃药观察三个月，一月底再复查"], "certainty": "confirmed", "status": "confirmed", "event_time": "2027-01 底", "valid_from": "2026-11-14 10:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 10:22", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "她照排班的样子列了三份清单：我妈的药、灰灰的喂药、年糕的粮", "subject": "HER", "relation": "日常安排", "evidence_uids": [8], "evidence_quotes": ["我妈的药一页，灰灰的喂药一页，年糕的粮一页，三本账"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 10:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 10:22", "history": []}, "f_0037": {"fact_id": "f_0037", "text": "灰灰今天吃了整罐", "subject": "HER", "relation": "猫的进食", "evidence_uids": [9], "evidence_quotes": ["今天灰灰吃了整罐"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16", "valid_from": "2026-11-16 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 22:17", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "她妈把药盒按早中晚排得比她还齐", "subject": "HER", "relation": "母亲的用药安排", "evidence_uids": [9], "evidence_quotes": ["我妈把她的药盒按早中晚排得比我还齐"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16", "valid_from": "2026-11-16 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 22:17", "history": []}, "f_0039": {"fact_id": "f_0039", "text": "她妈说她比小学整理书包那会儿强多了", "subject": "HER", "relation": "母亲的评价", "evidence_uids": [9], "evidence_quotes": ["说我比小学整理书包那会儿强多了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16", "valid_from": "2026-11-16 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 22:17", "history": []}, "f_0040": {"fact_id": "f_0040", "text": "她把一卷未拆封的弹性绷带放在驿站，取件码刚发给我", "subject": "HER", "relation": "关心/代喂往来", "evidence_uids": [10], "evidence_quotes": ["弹性绷带一卷，未拆封，阿荞塞给我的，我给你放驿站了，取件码刚发你。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-19", "valid_from": "2026-11-19 20:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 20:47", "history": []}, "f_0041": {"fact_id": "f_0041", "text": "她十二月要出趟长差，前后二十来天", "subject": "HER", "relation": "行程", "evidence_uids": [11], "evidence_quotes": ["十二月我要出趟长差，前后二十来天"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-12", "valid_from": "2026-11-21 22:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 22:37", "history": []}, "f_0042": {"fact_id": "f_0042", "text": "十二月上半月托我代喂灰灰、下半月托阿荞，报酬按顿记咖啡月底结", "subject": "UNKNOWN", "relation": "", "evidence_uids": [11], "evidence_quotes": ["上半月托你，下半月托阿荞，你俩的咖啡我按顿记账，月底一起结"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-21 22:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 22:37", "history": []}}, "fact_seq": 42, "updates": [{"fact_id": "f_0030", "action": "complete", "text": "手机充电后再说", "old_text": "手机充电后再说", "ts": "2026-11-13 18:37", "src_uids": [7], "quote": "电充上了。"}, {"fact_id": "f_0020", "action": "complete", "text": "她妈这周四约了专科复诊，她陪", "old_text": "她妈这周四约了专科复诊，她陪", "ts": "2026-11-14 10:22", "src_uids": [8], "quote": "我妈周四看完了专科"}, {"fact_id": "f_0029", "action": "complete", "text": "她妈周四的专科号挂上了", "old_text": "她妈周四的专科号挂上了", "ts": "2026-11-14 10:22", "src_uids": [8], "quote": "我妈周四看完了专科"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}