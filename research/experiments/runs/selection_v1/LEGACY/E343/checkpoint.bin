n_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "江疏雨是俱乐部两年会员兼周末安全员，市一医院急诊科护士，翻班排班紧。她有件前会员留下的3XL厚湿衣放在器材柜。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "俱乐部认识一个多月，她捞过他一次也教过他上板，互相损但都有分寸，熟得快的那一档。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "她说话先损一句再给正事，不喜欢都行式的敷衍答复。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "段云开，会游泳但怕冷水、接得住损、答应的事慢但稳", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "江疏雨，水性好、嘴快心细、翻班时脾气短，底线：安全的事不掺玩笑、忙的时候不许追问", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "今天下水第四次，落水也是第四次", "subject": "ME", "relation": "今日下水次数", "evidence_uids": [0], "evidence_quotes": ["我数了，第四次。落水也是第四次"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07", "valid_from": "2026-11-07 10:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 10:47", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "她看的下周六预报是风力三级，适合新手", "subject": "HER", "relation": "天气", "evidence_uids": [1], "evidence_quotes": ["下周六预报风力三级，适合新手"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 白天", "valid_from": "2026-11-08 20:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 20:22", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "她器材柜里有件前会员留下的3XL厚湿衣，一直空着", "subject": "HER", "relation": "器材", "evidence_uids": [1], "evidence_quotes": ["我器材柜里有件厚的，3XL，前会员留下的，一直空着"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-08 20:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 20:22", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "我现在穿的是俱乐部租的薄款湿衣", "subject": "ME", "relation": "器材", "evidence_uids": [1], "evidence_quotes": ["你身上那件是租的薄款吧"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-08 20:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-08 20:22", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "周六下水前去器材间找江疏雨拿那件3XL厚湿衣，暗号'氧气哥'，已敲定", "subject": "UNKNOWN", "relation": "", "evidence_uids": [1, 2], "evidence_quotes": ["我器材柜里有件厚的，3XL，前会员留下的，一直空着", "湿衣周六下水前你来器材间找我拿，暗号是氧气哥，不喊不给。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-09 12:47", "valid_to": "", "supersedes": "f_0011@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-08 20:22", "history": [{"status": "proposed", "text": "周六借她那件3XL厚湿衣，还没敲定", "valid_to": "2026-11-09 12:47", "reason": "correct", "src_uids": [2], "quote": "湿衣周六下水前你来器材间找我拿，暗号是氧气哥，不喊不给。"}]}, "f_0012": {"fact_id": "f_0012", "text": "她让我周六下水前去器材间找她拿那件厚湿衣，暗号是'氧气哥'", "subject": "HER", "relation": "约定", "evidence_uids": [2], "evidence_quotes": ["湿衣周六下水前你来器材间找我拿，暗号是氧气哥，不喊不给。"], "certainty": "confirmed", "status": "confirmed", "event_time": "周六下水前", "valid_from": "2026-11-09 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 12:47", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她让我对老驰说湿衣是安全员配发的", "subject": "HER", "relation": "说法", "evidence_uids": [2], "evidence_quotes": ["老驰要是问起来，就说是安全员配发，配发给某一个人的那种。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-09 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 12:47", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "冬季卡原价一千二，封板前续半价六百", "subject": "HER", "relation": "俱乐部会费", "evidence_uids": [3], "evidence_quotes": ["原价一千二，封板前续半价六百"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-11 21:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:37", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "今年封板定在11月22号", "subject": "HER", "relation": "俱乐部日程", "evidence_uids": [3], "evidence_quotes": ["今年封板定在11月22号"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22", "valid_from": "2026-11-11 21:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:37", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "她帮我问了冬季卡半价的事", "subject": "HER", "relation": "帮忙", "evidence_uids": [3], "evidence_quotes": ["半价的事我帮你问了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-11 21:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:37", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她给我留了12月双人板接力赛的位置", "subject": "HER", "relation": "赛事邀约", "evidence_uids": [4], "evidence_quotes": ["12月的双人板接力赛报名差一板，我给你留了位置"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-12", "valid_from": "2026-11-14 11:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 11:28", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她跟老驰说我是她的备用安全员", "subject": "HER", "relation": "玩笑称呼", "evidence_uids": [4], "evidence_quotes": ["那是我的备用安全员"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-14 11:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 11:28", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "我今天没下水，湿衣也没去拿", "subject": "ME", "relation": "当日状态", "evidence_uids": [4], "evidence_quotes": ["今天你没下水，湿衣也没来拿"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-14 11:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 11:28", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "12月双人板接力赛是否参加，由我决定", "subject": "UNKNOWN", "relation": "", "evidence_uids": [4], "evidence_quotes": ["上不上你说了算"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 11:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 11:28", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "她要我别给她报名12月双人板接力赛", "subject": "HER", "relation": "赛事报名", "evidence_uids": [5, 7], "evidence_quotes": ["接力赛先别给我报名。", "接力赛小隼说能帮我顶班，我又想报了"], "certainty": "confirmed", "status": "reopened", "event_time": "2026-11-16", "valid_from": "2026-11-19 21:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 08:56", "history": [{"status": "confirmed", "text": "她要我别给她报名12月双人板接力赛", "valid_to": "2026-11-19 21:12", "reason": "reopen", "src_uids": [7], "quote": "接力赛小隼说能帮我顶班，我又想报了"}]}, "f_0022": {"fact_id": "f_0022", "text": "她科室这个月排班翻大夜，一直翻到月底", "subject": "HER", "relation": "排班", "evidence_uids": [5], "evidence_quotes": ["科室这个月排班翻大夜，一直翻到月底"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11", "valid_from": "2026-11-16 08:56", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 08:56", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "12月的事她不敢打包票，忙完这阵再说", "subject": "UNKNOWN", "relation": "", "evidence_uids": [5], "evidence_quotes": ["12月的事我不敢打包票。最近别找我，忙完这阵再说。"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-16 08:56", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 08:56", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "她夜班连轴，凌晨四点在急诊走廊", "subject": "HER", "relation": "工作状态", "evidence_uids": [6], "evidence_quotes": ["夜班连轴，凌晨四点的急诊走廊"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-18 凌晨四点", "valid_from": "2026-11-18 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 22:17", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她今天下班了，只睡了四个小时，说自己人是馊的", "subject": "HER", "relation": "身体状态", "evidence_uids": [7], "evidence_quotes": ["下班了，睡了四个小时，人是馊的。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-19", "valid_from": "2026-11-19 21:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 21:12", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "小隼说能帮她顶班", "subject": "THIRD", "relation": "接力赛顶班", "evidence_uids": [7], "evidence_quotes": ["接力赛小隼说能帮我顶班"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-19 21:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 21:12", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "她改口说想报12月双人板接力赛，尚未敲定", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7], "evidence_quotes": ["我又想报了"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-19 21:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 21:12", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "她板上写的是“明年带新人下水”", "subject": "HER", "relation": "封板仪式板贴语", "evidence_uids": [8, 9], "evidence_quotes": ["我写了明年见白鹭湾", "我的板写的是明年带新人下水"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22", "valid_from": "2026-11-22 17:47", "valid_to": "", "supersedes": "f_0028@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-21 10:37", "history": [{"status": "confirmed", "text": "她给封板仪式写的句子是“明年见白鹭湾”", "valid_to": "2026-11-22 17:47", "reason": "correct", "src_uids": [9], "quote": "我的板写的是明年带新人下水"}]}, "f_0029": {"fact_id": "f_0029", "text": "她让我写好自己那句拍照发她审稿，不合格重写", "subject": "HER", "relation": "封板仪式板贴语", "evidence_uids": [8], "evidence_quotes": ["你写什么？写好拍照发我，我审稿，不合格重写"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-21 10:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 10:37", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "老驰说封板那天有仪式，每人在自己板上贴一句话", "subject": "THIRD", "relation": "俱乐部封板仪式安排", "evidence_uids": [8], "evidence_quotes": ["老驰说封板那天有仪式，每人在自己板上贴一句话"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22", "valid_from": "2026-11-21 10:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 10:37", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "她今天封板了", "subject": "HER", "relation": "俱乐部活动", "evidence_uids": [9], "evidence_quotes": ["封板了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22", "valid_from": "2026-11-22 17:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-22 17:47", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "她板上写的是“明年带新人下水”", "subject": "HER", "relation": "封板仪式", "evidence_uids": [9], "evidence_quotes": ["我的板写的是明年带新人下水"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22", "valid_from": "2026-11-22 17:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-22 17:47", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "明年开板预计三月底，续冬季卡的有早鸟场", "subject": "HER", "relation": "俱乐部安排", "evidence_uids": [9], "evidence_quotes": ["明年开板预计三月底，续了冬季卡的有早鸟场"], "certainty": "confirmed", "status": "confirmed", "event_time": "2027-03", "valid_from": "2026-11-22 17:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-22 17:47", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "她替我盯着六百块冬季卡名额", "subject": "HER", "relation": "冬季卡", "evidence_uids": [9], "evidence_quotes": ["你那六百块的名额我替你盯着"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22", "valid_from": "2026-11-22 17:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-22 17:47", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "接力赛定在12月13号，白鹭湾组队抽签", "subject": "HER", "relation": "赛事安排", "evidence_uids": [10], "evidence_quotes": ["接力赛定在12月13号，白鹭湾组队抽签"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-12-13", "valid_from": "2026-11-23 19:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 19:37", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "她和我一板", "subject": "SHARED", "relation": "组队", "evidence_uids": [10], "evidence_quotes": ["你跟我一板"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-12-13", "valid_from": "2026-11-23 19:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 19:37", "history": []}, "f_0037": {"fact_id": "f_0037", "text": "小隼顶她的夜班换出来的", "subject": "THIRD", "relation": "顶班", "evidence_uids": [10], "evidence_quotes": ["小隼顶我的夜班换出来的"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-23 19:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 19:37", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "周三晚在水上运动中心泳池练配合，恒温", "subject": "SHARED", "relation": "训练安排", "evidence_uids": [10], "evidence_quotes": ["周三晚在水上运动中心泳池练配合，恒温"], "certainty": "confirmed", "status": "confirmed", "event_time": "周三晚", "valid_from": "2026-11-23 19:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 19:37", "history": []}, "f_0039": {"fact_id": "f_0039", "text": "她修好了我上板的照片，落水那张单独修，配文是“氧气哥深海报告”", "subject": "HER", "relation": "照片", "evidence_uids": [11], "evidence_quotes": ["今天你上板的照片我修好了，落水那张单独修，配文氧气哥深海报告"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-24", "valid_from": "2026-11-24 22:07", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 22:07", "history": []}, "f_0040": {"fact_id": "f_0040", "text": "她冬天不下水", "subject": "HER", "relation": "习惯", "evidence_uids": [11], "evidence_quotes": ["冬天我不下水"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-24 22:07", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 22:07", "history": []}, "f_0041": {"fact_id": "f_0041", "text": "她要求落水、训练迟到、想偷懒都向她报备", "subject": "HER", "relation": "约定", "evidence_uids": [11], "evidence_quotes": ["落水要报备，训练迟到要报备，想偷懒也要报备"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-24 22:07", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 22:07", "history": []}}, "fact_seq": 41, "updates": [{"fact_id": "f_0011", "action": "correct", "text": "周六下水前去器材间找江疏雨拿那件3XL厚湿衣，暗号'氧气哥'，已敲定", "old_text": "周六借她那件3XL厚湿衣，还没敲定", "ts": "2026-11-09 12:47", "src_uids": [2], "quote": "湿衣周六下水前你来器材间找我拿，暗号是氧气哥，不喊不给。"}, {"fact_id": "f_0021", "action": "reopen", "text": "她要我别给她报名12月双人板接力赛", "old_text": "她要我别给她报名12月双人板接力赛", "ts": "2026-11-19 21:12", "src_uids": [7], "quote": "接力赛小隼说能帮我顶班，我又想报了"}, {"fact_id": "f_0028", "action": "correct", "text": "她板上写的是“明年带新人下水”", "old_text": "她给封板仪式写的句子是“明年见白鹭湾”", "ts": "2026-11-22 17:47", "src_uids": [9], "quote": "我的板写的是明年带新人下水"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}