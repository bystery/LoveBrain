": 1}], "memory_off": false, "flags": {"action_layer": true, "evidence_memory": true}, "mem": {"facts": {"f_0001": {"fact_id": "f_0001", "text": "阮青山是业余剧社道具组的骨干，剧社排原创短剧《候车》，排练每周二、周四晚，演出初定11月28日周六晚七点半，青年宫黑匣子剧场。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "苏念安在剧社做场记，白天在幼儿园带班，在《候车》里原是八句台词的群众角色，社里八卦多但她一概不应付。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "半年里他搬道具她记场记，散场常同路一段，再多的事没有。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "叫他阮师傅，剧社里都这么叫，紧张的时候说反话。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "阮青山，道具组顶梁柱，手巧、话不多，说的都在点上、对舞台有耐心", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "苏念安，场记做得比剧本还细、背词背进梦里、不会应付八卦，底线：家里的事不开玩笑、排练时间不聊闲篇", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "今晚导演把《候车》第三幕全推翻了", "subject": "THIRD", "relation": "排练变动", "evidence_uids": [0], "evidence_quotes": ["今晚导演把《候车》第三幕全推翻了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 晚", "valid_from": "2026-11-10 21:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:37", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "苏念安的台词从八句砍到两句", "subject": "HER", "relation": "角色变动", "evidence_uids": [0], "evidence_quotes": ["我的台词从八句砍到两句"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 晚", "valid_from": "2026-11-10 21:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:37", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "《候车》演出改为11月29日周日晚七点半，场地改为城北文化馆剧场", "subject": "SHARED", "relation": "演出安排", "evidence_uids": [0, 3], "evidence_quotes": ["28号周六晚七点半青年宫演出", "演出顺延一周改到29号周日还是七点半，场地从青年宫换到城北文化馆剧场"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-28 19:30", "valid_from": "2026-11-18 22:47", "valid_to": "", "supersedes": "f_0009@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:37", "history": [{"status": "confirmed", "text": "《候车》演出定11月28日周六晚七点半，青年宫", "valid_to": "2026-11-18 22:47", "reason": "correct", "src_uids": [3], "quote": "演出顺延一周改到29号周日还是七点半，场地从青年宫换到城北文化馆剧场"}]}, "f_0010": {"fact_id": "f_0010", "text": "社里每人摊五个名额卖票，一张四十", "subject": "SHARED", "relation": "票务", "evidence_uids": [0], "evidence_quotes": ["社里每人摊五个名额卖票，一张四十"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-10 21:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:37", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "周六下午市话剧团演《雷雨》，两点半场，一张八十，她多买了一张", "subject": "HER", "relation": "看戏邀约", "evidence_uids": [1], "evidence_quotes": ["周六下午市话剧团的《雷雨》，两点半场，一张八十，我多买了一张。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 14:30", "valid_from": "2026-11-12 12:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 12:27", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她下午就得给对方回话", "subject": "HER", "relation": "时间限制", "evidence_uids": [1], "evidence_quotes": ["去不去给个话，我下午就得回人家。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 下午", "valid_from": "2026-11-12 12:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 12:27", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "若我没空，多的一张票转给小橡", "subject": "UNKNOWN", "relation": "", "evidence_uids": [1], "evidence_quotes": ["你要没空我转手给小橡，她肯定要。"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-12 12:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 12:27", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "她已到家", "subject": "HER", "relation": "状态", "evidence_uids": [2], "evidence_quotes": ["到家了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 22:10", "valid_from": "2026-11-14 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 22:17", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "《雷雨》演了三个半小时，她多买的那张票是我去的", "subject": "SHARED", "relation": "看戏", "evidence_uids": [2], "evidence_quotes": ["《雷雨》三个半小时你居然没看表，这八十花得值"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 下午", "valid_from": "2026-11-14 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 22:17", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "她想的新结尾：候车亭的灯到最后一场才亮，人走了灯才亮", "subject": "HER", "relation": "创作想法", "evidence_uids": [2], "evidence_quotes": ["候车亭的灯到最后一场才亮，人走了灯才亮"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 22:17", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "明天连排她跟导演提这个新结尾", "subject": "UNKNOWN", "relation": "", "evidence_uids": [2], "evidence_quotes": ["明天连排我跟导演提"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 22:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 22:17", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "老利搬布景闪了腰", "subject": "THIRD", "relation": "剧社道具组", "evidence_uids": [3], "evidence_quotes": ["老利搬布景闪了腰"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-18 22:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 22:47", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "导演让B组顶上", "subject": "THIRD", "relation": "剧社安排", "evidence_uids": [3], "evidence_quotes": ["导演让B组顶上"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-18 22:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 22:47", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "演出顺延一周改到29号周日七点半，场地从青年宫换到城北文化馆剧场", "subject": "SHARED", "relation": "《候车》演出安排", "evidence_uids": [3], "evidence_quotes": ["演出顺延一周改到29号周日还是七点半，场地从青年宫换到城北文化馆剧场"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 19:30", "valid_from": "2026-11-18 22:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 22:47", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "票不退、改签不补差", "subject": "PUBLIC", "relation": "票务规则", "evidence_uids": [3], "evidence_quotes": ["票不退、改签不补差"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-18 22:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 22:47", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "我手上有五张名额的票", "subject": "ME", "relation": "剧社售票名额", "evidence_uids": [3], "evidence_quotes": ["你那五张名额的票别弄丢"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-18 22:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 22:47", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "苏念安在《候车》里的角色从两句台词变成三十七句，顶上了女二的戏份", "subject": "HER", "relation": "剧社演出", "evidence_uids": [5], "evidence_quotes": ["女二的戏份落我头上了，两句变三十七句"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21", "valid_from": "2026-11-21 20:39", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 20:39", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "苏念安的妈妈买了11月29日演出的票", "subject": "HER", "relation": "家人", "evidence_uids": [5], "evidence_quotes": ["我妈29号也买了票"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29", "valid_from": "2026-11-21 20:39", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 20:39", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "苏念安还没告诉妈妈自己演女二，打算演完再给她惊喜", "subject": "HER", "relation": "家人", "evidence_uids": [5], "evidence_quotes": ["我还不敢告诉她我演女二，想演完再给她个惊喜"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29", "valid_from": "2026-11-21 20:39", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 20:39", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "小橡她们在传她请我看话剧、老使唤我搬道具", "subject": "HER", "relation": "剧社八卦传闻", "evidence_uids": [6], "evidence_quotes": ["小橡她们开始传，说我请你看了话剧、老使唤你搬道具"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-23 21:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 21:17", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "她提我这几场可以来得少点，免得添话头", "subject": "UNKNOWN", "relation": "", "evidence_uids": [6], "evidence_quotes": ["这几场你要是来得少点也行，别为我添话头，戏要紧"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-23 21:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 21:17", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "29号散场庆功宴在排练厅，凑份子一人五十", "subject": "HER", "relation": "剧社安排", "evidence_uids": [7], "evidence_quotes": ["29号散场庆功宴在排练厅，凑份子一人五十"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 散场后", "valid_from": "2026-11-26 22:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 22:57", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "阮青山的票是C区4号", "subject": "ME", "relation": "演出座位", "evidence_uids": [7], "evidence_quotes": ["你票是C区4号"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 19:30", "valid_from": "2026-11-26 22:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 22:57", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "她妈坐C区3号，与我的座位隔一个扶手", "subject": "THIRD", "relation": "演出座位", "evidence_uids": [7], "evidence_quotes": ["我妈C区3号，隔一个扶手"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 19:30", "valid_from": "2026-11-26 22:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 22:57", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "八卦的事她周一已在社里说清楚：请我是因为我搬了十七趟道具", "subject": "HER", "relation": "剧社", "evidence_uids": [7], "evidence_quotes": ["八卦的事我周一在社里说清楚了：请你是因为你搬了十七趟道具，光明正大。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-23 周一", "valid_from": "2026-11-26 22:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 22:57", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "明晚七点半开演，六点演员到后台", "subject": "HER", "relation": "演出安排", "evidence_uids": [8], "evidence_quotes": ["明晚七点半开演，六点演员到后台"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 19:30", "valid_from": "2026-11-28 15:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-28 15:27", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "她三十七句词昨天梦里漏了四句，今天打算再过三遍", "subject": "HER", "relation": "排练", "evidence_uids": [8], "evidence_quotes": ["我三十七句词昨天梦里漏了四句，今天再过三遍"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-28", "valid_from": "2026-11-28 15:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-28 15:27", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "她让我对她妈妈实话实说自己做什么的，别顺着她编的版本来", "subject": "HER", "relation": "交代", "evidence_uids": [8], "evidence_quotes": ["你跟我妈说好，她要是问你做什么的，实话实说，别顺着我编的那个来"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29", "valid_from": "2026-11-28 15:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-28 15:27", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "她已进后台，妆比想象的重，睫毛上有东西，眨眼都怕掉", "subject": "HER", "relation": "演出前状态", "evidence_uids": [9], "evidence_quotes": ["都进后台了，妆比想象的重，睫毛上有东西，眨眼都怕掉。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 18:36", "valid_from": "2026-11-29 18:46", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 18:46", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "她妈妈到了剧场门口，穿红外套，拎着保温桶，说是给搬道具的阮师傅带的", "subject": "HER", "relation": "家人到场", "evidence_uids": [10], "evidence_quotes": ["我妈到门口了，穿红外套，手里拎着保温桶，说是给搬道具的阮师傅带的。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 18:41", "valid_from": "2026-11-29 18:46", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 18:46", "history": []}, "f_0037": {"fact_id": "f_0037", "text": "她要把五十块份子钱转给我，让我递给团长、替她谢全组", "subject": "HER", "relation": "庆功宴份子钱", "evidence_uids": [11], "evidence_quotes": ["五十块份子钱我现在转你，你帮我递给团长，替我谢全组"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 庆功宴", "valid_from": "2026-11-29 22:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 22:37", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "她妈跟车先回，让她玩尽兴", "subject": "THIRD", "relation": "她母亲", "evidence_uids": [11], "evidence_quotes": ["她跟车先回，让我玩尽兴"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 晚", "valid_from": "2026-11-29 22:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 22:37", "history": []}, "f_0039": {"fact_id": "f_0039", "text": "她妈今早打电话，让她谢谢我陪她坐了一整晚", "subject": "HER", "relation": "她妈对我的谢意", "evidence_uids": [12], "evidence_quotes": ["我妈今早打电话，让我谢谢你陪她坐了一整晚。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-30 早上", "valid_from": "2026-11-30 12:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 12:37", "history": []}, "f_0040": {"fact_id": "f_0040", "text": "她修出两张庆功宴照片，说晚上发我", "subject": "HER", "relation": "照片分享", "evidence_uids": [12, 13], "evidence_quotes": ["庆功宴照片我修出两张，晚上发你。", "照片发你了"], "certainty": "confirmed", "status": "completed", "event_time": "2026-11-30 晚上", "valid_from": "2026-11-30 12:37", "valid_to": "2026-11-30 21:47", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 12:37", "history": [{"status": "confirmed", "text": "她修出两张庆功宴照片，说晚上发我", "valid_to": "2026-11-30 21:47", "reason": "complete", "src_uids": [13], "quote": "照片发你了"}]}, "f_0041": {"fact_id": "f_0041", "text": "她妈一月想去杭州看她表姐，她说一月的事一月再说", "subject": "UNKNOWN", "relation": "", "evidence_uids": [12], "evidence_quotes": ["她还说一月想去杭州看我表姐，问我能不能——算了，一月的事一月再说。"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-30 12:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 12:37", "history": []}, "f_0042": {"fact_id": "f_0042", "text": "她把庆功宴照片发给我了", "subject": "HER", "relation": "照片", "evidence_uids": [13], "evidence_quotes": ["照片发你了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-30 21:40", "valid_from": "2026-11-30 21:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 21:47", "history": []}, "f_0043": {"fact_id": "f_0043", "text": "社里寒假前不排新戏", "subject": "HER", "relation": "剧社安排", "evidence_uids": [13], "evidence_quotes": ["社里寒假前不排新戏"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-30", "valid_from": "2026-11-30 21:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 21:47", "history": []}, "f_0044": {"fact_id": "f_0044", "text": "她说新戏定了会喊我", "subject": "HER", "relation": "约定口风", "evidence_uids": [13], "evidence_quotes": ["新戏定了喊你"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-30 21:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 21:47", "history": []}, "f_0045": {"fact_id": "f_0045", "text": "她要把场记本理一理、把三十七句词还给导演", "subject": "UNKNOWN", "relation": "", "evidence_uids": [13], "evidence_quotes": ["我把场记本理一理，三十七句词也该还给导演了"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-30 21:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-30 21:47", "history": []}}, "fact_seq": 45, "updates": [{"fact_id": "f_0009", "action": "correct", "text": "《候车》演出改为11月29日周日晚七点半，场地改为城北文化馆剧场", "old_text": "《候车》演出定11月28日周六晚七点半，青年宫", "ts": "2026-11-18 22:47", "src_uids": [3], "quote": "演出顺延一周改到29号周日还是七点半，场地从青年宫换到城北文化馆剧场"}, {"fact_id": "f_0040", "action": "complete", "text": "她修出两张庆功宴照片，说晚上发我", "old_text": "她修出两张庆功宴照片，说晚上发我", "ts": "2026-11-30 21:47", "src_uids": [13], "quote": "照片发你了"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}