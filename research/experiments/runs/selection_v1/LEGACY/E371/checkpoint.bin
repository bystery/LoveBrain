us": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "四年队友，她给柳岸闻带过两回山货，柳岸闻帮她修过三次炉头，谁也不提谢字。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "称呼柳哥，句子短，交代事情按东西、位置、时限三段说。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "柳岸闻，徒步队装备管家、车库有工具墙、话少手巧", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "越青梧，徒步小队领队、装备洁癖、句子短爱用装备名词，底线：公用器材用完必归位、不让人替她背锅", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "周六大岚山两日线定了，六人成行", "subject": "HER", "relation": "活动安排", "evidence_uids": [0], "evidence_quotes": ["周六大岚山两日线定了，六人成行"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-09 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "绿帐上回收时有点潮，要摊开查霉点", "subject": "HER", "relation": "器材状况", "evidence_uids": [0], "evidence_quotes": ["绿帐上回收的时候有点潮，摊开查霉点"], "certainty": "confirmed", "status": "unverified_src", "event_time": "", "valid_from": "2026-11-09 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "蓝帐这趟不用，不动", "subject": "HER", "relation": "器材安排", "evidence_uids": [0], "evidence_quotes": ["蓝帐不动，这趟用不上"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-09 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "头灯两支电量已核过，都够", "subject": "HER", "relation": "器材状况", "evidence_uids": [0], "evidence_quotes": ["头灯两支电量我看过了，都够"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-09 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "气炉点不着了", "subject": "SHARED", "relation": "公用器材状况", "evidence_uids": [1], "evidence_quotes": ["气炉点不着了"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-10 12:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:28", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她让我通完3号喷头后把备用炉头也点一遍", "subject": "HER", "relation": "交代事项", "evidence_uids": [1], "evidence_quotes": ["这次通了以后把备用炉头也点一遍"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-10 12:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:28", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她说上回是阿荞用完没吹管导致堵塞", "subject": "THIRD", "relation": "归因（未核实）", "evidence_uids": [1], "evidence_quotes": ["上回就是阿荞用完没吹管堵的"], "certainty": "tentative", "status": "tentative", "event_time": "", "valid_from": "2026-11-10 12:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:28", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "睡袋她上周已经洗过，让柳岸闻不用管，直接收着", "subject": "HER", "relation": "器材状态", "evidence_uids": [2], "evidence_quotes": ["睡袋我上周都洗过了，你不用管，直接收着就行。"], "certainty": "confirmed", "status": "confirmed", "event_time": "上周", "valid_from": "2026-11-10 21:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 21:12", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "周六只带绿帐；绿帐用白瓶无味防水剂，蓝帐用带喷枪那瓶", "subject": "HER", "relation": "器材使用分工", "evidence_uids": [3], "evidence_quotes": ["绿帐用白瓶无味那罐，蓝帐才用带喷枪那瓶，这周六只带绿帐"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-11 18:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 18:48", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "白瓶存量少于三分之一要告诉她", "subject": "HER", "relation": "器材盘点要求", "evidence_uids": [3], "evidence_quotes": ["白瓶存量你看一眼，少于三分之一跟我说"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-11 18:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 18:48", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她要求蓝帐这趟千万别喷防水剂，还没到保养周期", "subject": "HER", "relation": "器材保养交代", "evidence_uids": [4], "evidence_quotes": ["蓝帐这回千万别喷"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12", "valid_from": "2026-11-12 09:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 09:22", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "白瓶存量不够就先拿她抽屉里那半罐新的顶上，别买", "subject": "HER", "relation": "器材补给交代", "evidence_uids": [4, 10], "evidence_quotes": ["白瓶不够就先拿我抽屉里那半罐新的顶上，别买", "白瓶那半罐新的我塞包里了"], "certainty": "confirmed", "status": "completed", "event_time": "", "valid_from": "2026-11-12 09:22", "valid_to": "2026-11-14 16:28", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 09:22", "history": [{"status": "confirmed", "text": "白瓶存量不够就先拿她抽屉里那半罐新的顶上，别买", "valid_to": "2026-11-14 16:28", "reason": "complete", "src_uids": [10], "quote": "白瓶那半罐新的我塞包里了"}]}, "f_0019": {"fact_id": "f_0019", "text": "她说上周洗的是抓绒毯，两条睡袋都还没洗", "subject": "HER", "relation": "器材状态更正", "evidence_uids": [5], "evidence_quotes": ["上周洗的是抓绒毯，两条睡袋都还没洗，我记岔了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12", "valid_from": "2026-11-12 20:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 20:58", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "她请我今晚手洗两条睡袋并晾车库横杆，不方便就直说", "subject": "HER", "relation": "请求", "evidence_uids": [5], "evidence_quotes": ["你今晚帮我手洗了晾车库横杆行不行？不方便就直说，我自己来洗。"], "certainty": "tentative", "status": "tentative", "event_time": "2026-11-12 晚", "valid_from": "2026-11-12 20:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 20:58", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "睡袋改成各管各的：她拿她那条，我那条我自己定；今晚手洗晾横杆的请求不再按原样执行", "subject": "UNKNOWN", "relation": "", "evidence_uids": [5, 6], "evidence_quotes": ["你今晚帮我手洗了晾车库横杆行不行？", "睡袋我拿我那条"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 13:38", "valid_to": "", "supersedes": "f_0021@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-12 20:58", "history": [{"status": "proposed", "text": "今晚手洗睡袋晾横杆，待我答复", "valid_to": "2026-11-13 13:38", "reason": "correct", "src_uids": [6], "quote": "睡袋我拿我那条"}]}, "f_0022": {"fact_id": "f_0022", "text": "她定的周六集合清单：绿帐、防潮垫两块、主气炉带备用炉头、炊具一套、头灯两支", "subject": "HER", "relation": "周六出行器材清单", "evidence_uids": [6], "evidence_quotes": ["绿帐、防潮垫两块、主气炉带备用炉头、炊具一套、头灯两支"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15 周六", "valid_from": "2026-11-13 13:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 13:38", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "她拿她自己那条睡袋，我那条我自己定", "subject": "HER", "relation": "睡袋分配", "evidence_uids": [6], "evidence_quotes": ["睡袋我拿我那条"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15 周六", "valid_from": "2026-11-13 13:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 13:38", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "周六七点半体育馆东门集合", "subject": "SHARED", "relation": "集合时间地点", "evidence_uids": [6], "evidence_quotes": ["七点半体育馆东门集合"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15 07:30", "valid_from": "2026-11-13 13:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 13:38", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她那条睡袋没干透就带抓绒毯凑合", "subject": "UNKNOWN", "relation": "", "evidence_uids": [6], "evidence_quotes": ["没干透我就带抓绒毯凑合"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-13 13:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 13:38", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "两条睡袋都洗了，挂在车库横杆上", "subject": "ME", "relation": "器材准备", "evidence_uids": [7], "evidence_quotes": ["睡袋两条都洗了，挂车库横杆。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13 19:30", "valid_from": "2026-11-13 19:52", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:52", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "气炉3号喷头通了，备用炉头点火正常", "subject": "ME", "relation": "器材准备", "evidence_uids": [7], "evidence_quotes": ["气炉 3 号通了，备用炉头点火正常。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13 19:30", "valid_from": "2026-11-13 19:52", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:52", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "她那支头灯忘在公司，明早车上有支备用的，集合时带那支", "subject": "HER", "relation": "头灯", "evidence_uids": [8], "evidence_quotes": ["头灯我那支忘公司了，明早我车上还有支备用的，集合我带那支。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 早", "valid_from": "2026-11-13 19:52", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:52", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "她已出发，路上顺路带上了阿荞", "subject": "HER", "relation": "同行", "evidence_uids": [9], "evidence_quotes": ["出发了，路上捡了阿荞。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 早上", "valid_from": "2026-11-14 07:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 07:18", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "阿荞在群里说这回记得吹管，让她转告我别老拿3号喷头说他", "subject": "THIRD", "relation": "队友", "evidence_uids": [9], "evidence_quotes": ["他刚在群里说这回记得吹管了，让你别老拿 3 号喷头说他。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 早上", "valid_from": "2026-11-14 07:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 07:18", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "她已到营地，扎在背风坡，风比预报小", "subject": "HER", "relation": "行程近况", "evidence_uids": [10], "evidence_quotes": ["到营地了，扎在背风坡，风比预报小"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 16:20", "valid_from": "2026-11-14 16:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 16:28", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "绿帐今晚不喷剂，明天收帐前她给底面补一遍", "subject": "HER", "relation": "装备安排", "evidence_uids": [10], "evidence_quotes": ["绿帐今晚不喷剂，明天收帐前我给底面补一遍"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14/15", "valid_from": "2026-11-14 16:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 16:28", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "白瓶那半罐新的她塞包里了", "subject": "HER", "relation": "装备携带", "evidence_uids": [10], "evidence_quotes": ["白瓶那半罐新的我塞包里了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-14 16:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 16:28", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "明天收帐前给绿帐底面补一遍防水", "subject": "UNKNOWN", "relation": "", "evidence_uids": [10], "evidence_quotes": ["明天收帐前我给底面补一遍"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 16:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 16:28", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "她回来了，累瘫", "subject": "HER", "relation": "状态", "evidence_uids": [11], "evidence_quotes": ["回来了，累瘫"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16 20:30", "valid_from": "2026-11-16 20:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 20:38", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "绿帐查过没霉点，底面蹭了泥，摊在我车库地上", "subject": "HER", "relation": "器材状态", "evidence_uids": [11], "evidence_quotes": ["绿帐查过没霉点，就是底面蹭了泥，我摊你车库地上了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16", "valid_from": "2026-11-16 20:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 20:38", "history": []}, "f_0037": {"fact_id": "f_0037", "text": "防水剂带去又带回来，没喷；白瓶存量让我核数", "subject": "HER", "relation": "器材交代", "evidence_uids": [11], "evidence_quotes": ["防水剂带去又带回来，没舍得喷，白瓶存量你自己核下数"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-16 20:30", "valid_from": "2026-11-16 20:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 20:38", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "下周日11-29跟小莞她们去嵊泗海岛线，蓝帐用得上", "subject": "HER", "relation": "行程安排", "evidence_uids": [12], "evidence_quotes": ["下周日 11-29 跟小莞她们去嵊泗海岛线，蓝帐用得上"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29", "valid_from": "2026-11-17 12:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 12:18", "history": []}, "f_0039": {"fact_id": "f_0039", "text": "带喷枪那瓶防水剂先试喷头，上回喷到一半堵过", "subject": "HER", "relation": "器材交接", "evidence_uids": [12], "evidence_quotes": ["带喷枪那瓶你先试下喷头，上回它喷到一半堵过"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-17 12:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 12:18", "history": []}, "f_0040": {"fact_id": "f_0040", "text": "绿帐收好按老规矩", "subject": "HER", "relation": "器材交接", "evidence_uids": [12], "evidence_quotes": ["绿帐收好按老规矩"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-17 12:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 12:18", "history": []}}, "fact_seq": 40, "updates": [{"fact_id": "f_0021", "action": "correct", "text": "睡袋改成各管各的：她拿她那条，我那条我自己定；今晚手洗晾横杆的请求不再按原样执行", "old_text": "今晚手洗睡袋晾横杆，待我答复", "ts": "2026-11-13 13:38", "src_uids": [6], "quote": "睡袋我拿我那条"}, {"fact_id": "f_0018", "action": "complete", "text": "白瓶存量不够就先拿她抽屉里那半罐新的顶上，别买", "old_text": "白瓶存量不够就先拿她抽屉里那半罐新的顶上，别买", "ts": "2026-11-14 16:28", "src_uids": [10], "quote": "白瓶那半罐新的我塞包里了"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}