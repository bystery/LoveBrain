k_delivered": true, "facts_added": 2, "updates_applied": 0}], "memory_off": false, "flags": {"action_layer": true, "evidence_memory": true}, "mem": {"facts": {"f_0001": {"fact_id": "f_0001", "text": "雷震野自产辣酱，报名了社区邻里节义卖，和业委会联络人老驰打过球，群里的消息他回得慢但准。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "柏知许是同小区邻居，做手工皂，报了邻里节义卖的皂摊并当桌主，爱转述消息，账常记岔但肯认。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "筹备群里认识两年，今年头一回搭伙摆摊，她称他雷哥，他叫她柏知许。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "她报数常带'好像'和'老驰说'；他回话先核对再答应，错了当场说。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "雷震野，自家做辣酱、跟老驰打过球，消息灵、不爱抢话，数目错了当场纠正", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "柏知许，做手工皂，账不过夜但常记岔、消息灵，爱转述、错了肯认，认完嘴上还要硬一句，底线：垫付的钱必还、打听来的话不当定论", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "柏知许报了邻里节义卖的皂摊，是桌主", "subject": "HER", "relation": "邻里节义卖", "evidence_uids": [0], "evidence_quotes": ["邻里节义卖我报了皂摊，桌主是我"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-09 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "老驰发的《义卖须知》：摊位费一桌一百，一桌限一摊，两家合摊按一桌收（合摊一人五十）", "subject": "THIRD", "relation": "摊位费", "evidence_uids": [0, 3], "evidence_quotes": ["老驰在群里说，一桌两摊要交两份摊位费，一人八十", "摊位费一桌一百，一桌限一摊，两家合摊按一桌收"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 21:22", "valid_to": "", "supersedes": "f_0008@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": [{"status": "tentative", "text": "柏知许转述老驰在群里说：一桌两摊要交两份摊位费，一人八十", "valid_to": "2026-11-13 21:22", "reason": "correct", "src_uids": [3], "quote": "摊位费一桌一百，一桌限一摊，两家合摊按一桌收"}]}, "f_0009": {"fact_id": "f_0009", "text": "雷震野若点头，柏知许今晚把他的名字报上去拼桌", "subject": "UNKNOWN", "relation": "", "evidence_uids": [0], "evidence_quotes": ["你点头我今晚就把你名字报上去"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-09 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "今年摆摊要交押金五十，验收干净就退", "subject": "THIRD", "relation": "摊位规则（郑荇转述老驰）", "evidence_uids": [1, 6], "evidence_quotes": ["今年老驰跟她讲押金五十，验收干净就退", "押金五十属实，验收后退"], "certainty": "tentative", "status": "completed", "event_time": "2026年", "valid_from": "2026-11-10 12:34", "valid_to": "2026-11-17 20:36", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:34", "history": [{"status": "tentative", "text": "今年摆摊要交押金五十，验收干净就退", "valid_to": "2026-11-17 20:36", "reason": "complete", "src_uids": [6], "quote": "押金五十属实，验收后退"}]}, "f_0011": {"fact_id": "f_0011", "text": "去年摊位费八十", "subject": "THIRD", "relation": "郑荇去年交的摊位费", "evidence_uids": [1], "evidence_quotes": ["去年她交的摊位费就是八十"], "certainty": "tentative", "status": "tentative", "event_time": "去年", "valid_from": "2026-11-10 12:34", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:34", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "柏知许的皂要摆三层架，占地方；她问八十里是否含桌布和电、桌布用不用另买", "subject": "HER", "relation": "摊位布置与费用", "evidence_uids": [2], "evidence_quotes": ["我的皂要摆三层架，占地方"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-11 20:27", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 20:27", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "用电已明确：提前登记另收三十；桌布须知未提，仍待核实", "subject": "UNKNOWN", "relation": "", "evidence_uids": [2, 3], "evidence_quotes": ["你上次说八十里含桌布和电，那我桌布就不用另买了吧？", "用电要提前登记，另收三十"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 21:22", "valid_to": "", "supersedes": "f_0013@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-11 20:27", "history": [{"status": "proposed", "text": "八十是否含桌布和电，待向老驰核实", "valid_to": "2026-11-13 21:22", "reason": "correct", "src_uids": [3], "quote": "用电要提前登记，另收三十"}]}, "f_0014": {"fact_id": "f_0014", "text": "老驰把盖章的《义卖须知》拍照发群里", "subject": "THIRD", "relation": "邻里节义卖文件", "evidence_uids": [3], "evidence_quotes": ["老驰把盖章的《义卖须知》拍照发群里了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13", "valid_from": "2026-11-13 21:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:22", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "摊位费一桌一百，一桌限一摊，两家合摊按一桌收", "subject": "PUBLIC", "relation": "义卖须知", "evidence_uids": [3], "evidence_quotes": ["摊位费一桌一百，一桌限一摊，两家合摊按一桌收"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 21:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:22", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "押金五十，验收后退", "subject": "PUBLIC", "relation": "义卖须知", "evidence_uids": [3], "evidence_quotes": ["押金五十，验收后退"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 21:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:22", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "用电要提前登记，另收三十", "subject": "PUBLIC", "relation": "义卖须知", "evidence_uids": [3], "evidence_quotes": ["用电要提前登记，另收三十"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 21:22", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:22", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "柏知许说省下的钱够进一批皂盒", "subject": "HER", "relation": "打算", "evidence_uids": [4], "evidence_quotes": ["这钱够我进一批皂盒"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 10:33", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 10:33", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "老驰在群里正式回复：雨天市集挪物业架空层，摊位费不退但押金照退", "subject": "THIRD", "relation": "转述消息，未核实", "evidence_uids": [5, 6], "evidence_quotes": ["郑荇又说，老驰私下讲雨天市集挪物业架空层，摊位费不退。", "雨天挪架空层，摊位费不退但押金照退"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-17 20:36", "valid_to": "", "supersedes": "f_0019@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-16 19:41", "history": [{"status": "tentative", "text": "柏知许转述郑荇的话：老驰私下讲雨天市集挪物业架空层、摊位费不退", "valid_to": "2026-11-17 20:36", "reason": "correct", "src_uids": [6], "quote": "雨天挪架空层，摊位费不退但押金照退"}]}, "f_0020": {"fact_id": "f_0020", "text": "柏知许让雷震野去问老驰，并要求别说是她打听的", "subject": "HER", "relation": "请求", "evidence_uids": [5], "evidence_quotes": ["你去问一句呗？问到了告诉我，别说是我打听的——我怂。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-16 19:41", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 19:41", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "雷震野去问老驰雨天挪场与摊位费退不退（尚未去问）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [5, 6], "evidence_quotes": ["你去问一句呗？", "老驰在群里正式回了三条"], "certainty": "tentative", "status": "cancelled", "event_time": "", "valid_from": "2026-11-16 19:41", "valid_to": "2026-11-17 20:36", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-16 19:41", "history": [{"status": "proposed", "text": "雷震野去问老驰雨天挪场与摊位费退不退（尚未去问）", "valid_to": "2026-11-17 20:36", "reason": "cancel", "src_uids": [6], "quote": "老驰在群里正式回了三条"}]}, "f_0022": {"fact_id": "f_0022", "text": "老驰在群里正式回复：押金五十属实，验收后退", "subject": "THIRD", "relation": "义卖须知", "evidence_uids": [6], "evidence_quotes": ["押金五十属实，验收后退"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-17", "valid_from": "2026-11-17 20:36", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 20:36", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "老驰在群里正式回复：雨天挪架空层，摊位费不退但押金照退", "subject": "THIRD", "relation": "义卖须知", "evidence_uids": [6], "evidence_quotes": ["雨天挪架空层，摊位费不退但押金照退"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-17", "valid_from": "2026-11-17 20:36", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 20:36", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "老驰在群里正式回复：合摊两家名字都要上报名表", "subject": "THIRD", "relation": "义卖须知", "evidence_uids": [6], "evidence_quotes": ["合摊两家名字都要上报名表"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-17", "valid_from": "2026-11-17 20:36", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 20:36", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "柏知许承认八十是郑荇去年交的数，自己记串成今年的群消息", "subject": "HER", "relation": "认账", "evidence_uids": [6], "evidence_quotes": ["八十是郑荇去年交的数，我记串成今年的群消息"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-17", "valid_from": "2026-11-17 20:36", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 20:36", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "柏知许承认“八十含桌布”雷震野没说过，是她把郑荇那句“桌布自带”记混了", "subject": "HER", "relation": "认账", "evidence_uids": [6], "evidence_quotes": ["是我把郑荇那句“桌布自带”记混了"], "certainty": "confirmed", "status": "unverified_src", "event_time": "2026-11-17", "valid_from": "2026-11-17 20:36", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 20:36", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "她自己定了只摆周六一天，只登到周六", "subject": "HER", "relation": "邻里节义卖摊位安排", "evidence_uids": [7], "evidence_quotes": ["我定了就摆周六一天"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21", "valid_from": "2026-11-19 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 12:47", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "义卖日程：11月21号周六、22号周日，周六9点到17点，周日15点收", "subject": "PUBLIC", "relation": "义卖须知日程", "evidence_uids": [7], "evidence_quotes": ["周六9点到17点，周日15点收"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21 至 2026-11-22", "valid_from": "2026-11-19 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 12:47", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "周日提前收是因为晚上广场有灯会", "subject": "PUBLIC", "relation": "义卖须知日程", "evidence_uids": [7], "evidence_quotes": ["周日提前收，说是晚上广场有灯会"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22", "valid_from": "2026-11-19 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 12:47", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "押金是否按天算，待她问老驰", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7], "evidence_quotes": ["押金按天算吗？算了你别答这个，你也不知道，我问老驰去。"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-19 12:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 12:47", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "柏知许垫付一百五：摊位费一百对半、押金五十对半，雷震野应付七十五", "subject": "HER", "relation": "摆摊费用分摊", "evidence_uids": [8], "evidence_quotes": ["一百五我垫的：摊位费一百对半，你五十；押金五十对半，你二十五——一共七十五，你微信转我"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-20 21:37", "valid_from": "2026-11-20 21:44", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-20 21:44", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "押金退回为整五十，归柏知许", "subject": "HER", "relation": "押金归属", "evidence_uids": [8], "evidence_quotes": ["押金退回来是整五十，归我，我不赚你差价，别推"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-20 21:44", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-20 21:44", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "柏知许说辣酱卖了二十一罐，皂剩四块", "subject": "HER", "relation": "当天义卖结果", "evidence_uids": [9], "evidence_quotes": ["辣酱卖了二十一罐，皂剩四块"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21 收摊时", "valid_from": "2026-11-21 17:49", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 17:49", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "老驰说明早九点物业层退押金，当天结", "subject": "HER", "relation": "转述老驰的通知", "evidence_uids": [9, 10], "evidence_quotes": ["老驰说明早九点物业层退押金，当天结", "押金到手，五十现金一分不少，老驰九点整在物业等我。"], "certainty": "tentative", "status": "completed", "event_time": "2026-11-22 09:00", "valid_from": "2026-11-21 17:49", "valid_to": "2026-11-22 09:52", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 17:49", "history": [{"status": "tentative", "text": "老驰说明早九点物业层退押金，当天结", "valid_to": "2026-11-22 09:52", "reason": "complete", "src_uids": [10], "quote": "押金到手，五十现金一分不少，老驰九点整在物业等我。"}]}, "f_0035": {"fact_id": "f_0035", "text": "郑荇说她去年等了一个礼拜", "subject": "HER", "relation": "转述郑荇的经历", "evidence_uids": [9], "evidence_quotes": ["郑荇说她去年等了一个礼拜"], "certainty": "confirmed", "status": "confirmed", "event_time": "去年", "valid_from": "2026-11-21 17:49", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 17:49", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "押金五十现金一分不少到手，老驰九点整在物业等她", "subject": "HER", "relation": "押金退还", "evidence_uids": [10], "evidence_quotes": ["押金到手，五十现金一分不少，老驰九点整在物业等我。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22 09:00", "valid_from": "2026-11-22 09:52", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-22 09:52", "history": []}, "f_0037": {"fact_id": "f_0037", "text": "她截了老驰“当天结”原话的图", "subject": "HER", "relation": "证据留存", "evidence_uids": [10], "evidence_quotes": ["他原话'当天结'我截了图。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-22 09:52", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-22 09:52", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "柏知许把二十五转回给雷震野，双方账两清", "subject": "HER", "relation": "结账", "evidence_uids": [11], "evidence_quotes": ["你那二十五我现在转回去——这回真两清了"], "certainty": "tentative", "status": "tentative", "event_time": "2026-11-23", "valid_from": "2026-11-23 21:33", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 21:33", "history": []}, "f_0039": {"fact_id": "f_0039", "text": "昨晚灯会人挤人", "subject": "HER", "relation": "现场情况", "evidence_uids": [11], "evidence_quotes": ["昨晚灯会人挤人"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-22 晚", "valid_from": "2026-11-23 21:33", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 21:33", "history": []}, "f_0040": {"fact_id": "f_0040", "text": "明年邻里节是否继续拼桌，尚未敲定", "subject": "UNKNOWN", "relation": "", "evidence_uids": [11], "evidence_quotes": ["明年邻里节，你还拼不拼桌？"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-23 21:33", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-23 21:33", "history": []}}, "fact_seq": 40, "updates": [{"fact_id": "f_0008", "action": "correct", "text": "老驰发的《义卖须知》：摊位费一桌一百，一桌限一摊，两家合摊按一桌收（合摊一人五十）", "old_text": "柏知许转述老驰在群里说：一桌两摊要交两份摊位费，一人八十", "ts": "2026-11-13 21:22", "src_uids": [3], "quote": "摊位费一桌一百，一桌限一摊，两家合摊按一桌收"}, {"fact_id": "f_0013", "action": "correct", "text": "用电已明确：提前登记另收三十；桌布须知未提，仍待核实", "old_text": "八十是否含桌布和电，待向老驰核实", "ts": "2026-11-13 21:22", "src_uids": [3], "quote": "用电要提前登记，另收三十"}, {"fact_id": "f_0019", "action": "correct", "text": "老驰在群里正式回复：雨天市集挪物业架空层，摊位费不退但押金照退", "old_text": "柏知许转述郑荇的话：老驰私下讲雨天市集挪物业架空层、摊位费不退", "ts": "2026-11-17 20:36", "src_uids": [6], "quote": "雨天挪架空层，摊位费不退但押金照退"}, {"fact_id": "f_0021", "action": "cancel", "text": "雷震野去问老驰雨天挪场与摊位费退不退（尚未去问）", "old_text": "雷震野去问老驰雨天挪场与摊位费退不退（尚未去问）", "ts": "2026-11-17 20:36", "src_uids": [6], "quote": "老驰在群里正式回了三条"}, {"fact_id": "f_0010", "action": "complete", "text": "今年摆摊要交押金五十，验收干净就退", "old_text": "今年摆摊要交押金五十，验收干净就退", "ts": "2026-11-17 20:36", "src_uids": [6], "quote": "押金五十属实，验收后退"}, {"fact_id": "f_0034", "action": "complete", "text": "老驰说明早九点物业层退押金，当天结", "old_text": "老驰说明早九点物业层退押金，当天结", "ts": "2026-11-22 09:52", "src_uids": [10], "quote": "押金到手，五十现金一分不少，老驰九点整在物业等我。"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}