d": true, "anchor": "m0", "anchor_valid": true, "hook_kind": "小选择", "hook_delivered": true, "facts_added": 2, "updates_applied": 2}], "memory_off": false, "flags": {"action_layer": true, "evidence_memory": true}, "mem": {"facts": {"f_0001": {"fact_id": "f_0001", "text": "贾云舟居家办公，白天基本在家，玄关常年腾出一块地方帮邻居暂存快递，跟小区驿站的老关打过不少照面。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "祝清越住 3 栋 1202，通勤远加班多，双十一囤了猫粮猫条和一批生活用品，快递经常到家时人不在。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "邻里两年，祝清越出差会给贾云舟带当地点心，贾云舟帮她收过几回件，谁也没正经道过谢。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "称呼云舟，说话列条目，交代完补一句收尾，改主意会直接说改了。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "贾云舟，居家办公的插画师、白天基本在家、跟小区驿站熟门熟路", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "祝清越，上班族常加班、交代事情爱列条目、收发件多，底线：不占人便宜、麻烦人必谢", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "她今天到货只有猫砂一件（京东）；羽绒服（申通）商家地址打成老家，今天追不回，明天重新发出", "subject": "HER", "relation": "快递", "evidence_uids": [0, 1], "evidence_quotes": ["我今天两个件到：一件羽绒服，申通的；一箱猫砂，京东的，都写的我家地址 3 栋 1202", "今天到货的就猫砂一件，你只收猫砂就行哈"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 13:12", "valid_to": "", "supersedes": "f_0007@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-09 09:20", "history": [{"status": "confirmed", "text": "她今天有两个件到：一件羽绒服（申通）、一箱猫砂（京东），地址写的是3栋1202", "valid_to": "2026-11-09 13:12", "reason": "correct", "src_uids": [1], "quote": "今天到货的就猫砂一件，你只收猫砂就行哈"}]}, "f_0008": {"fact_id": "f_0008", "text": "她请我把两个件放我家玄关暂存", "subject": "SHARED", "relation": "邻里代收", "evidence_uids": [0], "evidence_quotes": ["放你家玄关就行"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 09:20", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 09:20", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "她晚上七点半下班后过来拎件", "subject": "HER", "relation": "时间安排", "evidence_uids": [0], "evidence_quotes": ["我晚上七点半下班过来拎"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 19:30", "valid_from": "2026-11-09 09:20", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 09:20", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "她更正：羽绒服那单商家把地址打成老家，今天追不回来，明天才能重新发出", "subject": "HER", "relation": "快递更正", "evidence_uids": [1], "evidence_quotes": ["羽绒服那单商家把我地址打成老家了，快递员说今天追不回来，明天才能重新发出"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 13:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 13:12", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "她今天到货的只有猫砂一件，让我只收猫砂", "subject": "HER", "relation": "快递安排", "evidence_uids": [1], "evidence_quotes": ["今天到货的就猫砂一件，你只收猫砂就行哈"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 13:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 13:12", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她今晚加班到十点，先不过来取件", "subject": "HER", "relation": "今晚安排", "evidence_uids": [2], "evidence_quotes": ["我今晚加班到十点，先不过去了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 晚", "valid_from": "2026-11-09 20:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 20:48", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她明早八点出门，顺路来拎猫砂", "subject": "HER", "relation": "取件时间", "evidence_uids": [2], "evidence_quotes": ["明早八点出门顺路拎走，就一分钟的事"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 08:00", "valid_from": "2026-11-09 20:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 20:48", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "她让我把羽绒服放我家玄关，她晚上来拿", "subject": "HER", "relation": "请求/约定", "evidence_uids": [3], "evidence_quotes": ["到了放玄关就行，我晚上来拿"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 晚上", "valid_from": "2026-11-10 09:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 09:38", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "小莼那箱面粉改到明晚（2026-11-11）八点来取，只取玄关那箱面粉，其余不动", "subject": "THIRD", "relation": "转述安排", "evidence_uids": [3, 4], "evidence_quotes": ["我闺蜜小莼网购的一箱面粉填的我家地址，明天到，她明天上午十点来你家取", "改成明晚八点来取"], "certaint