"", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:28", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "周五排练陈老师点霍青崖单句重唱三遍", "subject": "ME", "relation": "排练", "evidence_uids": [0], "evidence_quotes": ["今晚周五排练，陈老师点你单句重唱三遍"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13 晚排练", "valid_from": "2026-11-13 21:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 21:28", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "陈老师安排男女声部互换试《贝加尔湖畔》", "subject": "THIRD", "relation": "排练安排", "evidence_uids": [1], "evidence_quotes": ["陈老师说男女声部互换试《贝加尔湖畔》"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-17 排练", "valid_from": "2026-11-17 21:20", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 21:20", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "休息时有人举手要跟霍青崖一组，她给的提示是女低音、姓顾", "subject": "HER", "relation": "排练分组", "evidence_uids": [1], "evidence_quotes": ["刚才休息的时候有人举手要跟你一组，你猜是谁。提示：女低音，姓顾。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-17 排练休息", "valid_from": "2026-11-17 21:20", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-17 21:20", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "她承认昨天休息时举手要和霍青崖一组的人是她自己", "subject": "HER", "relation": "合唱团声部互换分组", "evidence_uids": [2], "evidence_quotes": ["猜不着吧，是我"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-17排练休息时", "valid_from": "2026-11-18 13:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 13:12", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "小莼说她主动", "subject": "THIRD", "relation": "团里同伴的评价", "evidence_uids": [2], "evidence_quotes": ["小莼说我主动"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-18 13:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 13:12", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "琴房信箱里有一盒金嗓子", "subject": "ME", "relation": "物件", "evidence_uids": [3], "evidence_quotes": ["琴房信箱里有盒金嗓子，别问谁放的。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-19", "valid_from": "2026-11-19 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 19:47", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "声乐老师说顾星晚声带充血，这周禁唱禁多话", "subject": "HER", "relation": "身体状况", "evidence_uids": [4], "evidence_quotes": ["声乐老师说我声带充血，这周禁唱禁多话。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-19当周", "valid_from": "2026-11-19 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 19:47", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "顾星晚周六北山团建去不了", "subject": "HER", "relation": "行程", "evidence_uids": [4], "evidence_quotes": ["周六北山团建我去不了了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21周六", "valid_from": "2026-11-19 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 19:47", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "票务的事由霍青崖直接找老桂", "subject": "SHARED", "relation": "安排", "evidence_uids": [4], "evidence_quotes": ["票务的事你直接找老桂，别再发我微信了"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-19 19:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 19:47", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她那盒含片是她自己拿走的，并说挺管用", "subject": "HER", "relation": "身体状态", "evidence_uids": [5], "evidence_quotes": ["含片挺管用，那盒我拿走了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-21", "valid_from": "2026-11-21 16:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 16:18", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她说山上有人开嗓，隔两条街都听得见", "subject": "HER", "relation": "当日情况", "evidence_uids": [5], "evidence_quotes": ["你们在山上是不是又开嗓了？隔两条街我都听见了。"], "certainty": "tentative", "status": "tentative", "event_time": "2026-11-21", "valid_from": "2026-11-21 16:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-21 16:18", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "陈老师把《贝加尔湖畔》独唱段正式给了顾星晚", "subject": "HER", "relation": "排练安排", "evidence_uids": [6], "evidence_quotes": ["陈老师把《贝加尔湖畔》独唱段正式给我了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-24", "valid_from": "2026-11-24 22:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 22:12", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "顾星晚练独唱段练到22点后", "subject": "HER", "relation": "排练", "evidence_uids": [6, 11], "evidence_quotes": ["我练到刚才", "独唱段稳住了"], "certainty": "confirmed", "status": "completed", "event_time": "2026-11-24 晚", "valid_from": "2026-11-24 22:12", "valid_to": "2026-11-29 21:42", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 22:12", "history": [{"status": "confirmed", "text": "顾星晚练独唱段练到22点后", "valid_to": "2026-11-29 21:42", "reason": "complete", "src_uids": [11], "quote": "独唱段稳住了"}]}, "f_0021": {"fact_id": "f_0021", "text": "顾星晚说台上只看霍青崖打的手势", "subject": "HER", "relation": "台上配合", "evidence_uids": [6], "evidence_quotes": ["台上我谁都不看，就看给你打的那个手势"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-24 22:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 22:12", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "她睡不着，词在脑子里排队", "subject": "HER", "relation": "身体状态", "evidence_uids": [7], "evidence_quotes": ["睡不着，词在脑子里排队"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-25 23:30", "valid_from": "2026-11-25 23:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-25 23:38", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "汇演散场后他请她吃夜宵，她说到时就来（条件式提议，未敲定细节）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7, 8], "evidence_quotes": ["汇演那天散场，你要是敢请我吃夜宵，我就敢来", "昨晚的话当我没说。"], "certainty": "tentative", "status": "cancelled", "event_time": "", "valid_from": "2026-11-25 23:38", "valid_to": "2026-11-26 08:26", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-25 23:38", "history": [{"status": "proposed", "text": "汇演散场后他请她吃夜宵，她说到时就来（条件式提议，未敲定细节）", "valid_to": "2026-11-26 08:26", "reason": "cancel", "src_uids": [8], "quote": "昨晚的话当我没说。"}]}, "f_0024": {"fact_id": "f_0024", "text": "她说团里人多眼杂，怕被小莼看见写进群里", "subject": "HER", "relation": "顾虑", "evidence_uids": [8], "evidence_quotes": ["团里人多眼杂，被小莼看见又得写进她们群里。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-26 08:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 08:26", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她预告周五排练可能戴帽子，让我别多问", "subject": "HER", "relation": "预告", "evidence_uids": [8], "evidence_quotes": ["周五排练我要是戴了帽子，你别多问。"], "certainty": "tentative", "status": "tentative", "event_time": "2026-11-27 周五晚排练", "valid_from": "2026-11-26 08:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 08:26", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "小莼让她问哪家餐馆适合散伙饭，要价便宜量又大的", "subject": "HER", "relation": "转述小莼的请求", "evidence_uids": [9], "evidence_quotes": ["小莼让我问哪家餐馆适合散伙饭，价便宜量又大那种"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-27 12:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-27 12:37", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "散伙饭选哪家餐馆还没定，她说是随口问问", "subject": "UNKNOWN", "relation": "", "evidence_uids": [9, 12], "evidence_quotes": ["我随口问问的，你别上心。", "散伙饭我推了"], "certainty": "tentative", "status": "cancelled", "event_time": "", "valid_from": "2026-11-27 12:37", "valid_to": "2026-11-29 21:42", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-27 12:37", "history": [{"status": "proposed", "text": "散伙饭选哪家餐馆还没定，她说是随口问问", "valid_to": "2026-11-29 21:42", "reason": "cancel", "src_uids": [12], "quote": "散伙饭我推了"}]}, "f_0028": {"fact_id": "f_0028", "text": "她哥今天坐高铁到了", "subject": "THIRD", "relation": "她哥", "evidence_uids": [10], "evidence_quotes": ["我哥高铁到了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-28", "valid_from": "2026-11-28 15:07", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-28 15:07", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "明天（11月29日）演出", "subject": "SHARED", "relation": "街道汇演", "evidence_uids": [10], "evidence_quotes": ["明天演出"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29", "valid_from": "2026-11-28 15:07", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-28 15:07", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "她跟她哥说有个特别稳的低音搭子，台上不抢拍；她哥追问是什么搭子，她没理", "subject": "HER", "relation": "", "evidence_uids": [10], "evidence_quotes": ["我跟他说我有个特别稳的低音搭子，台上从来不抢拍。他问搭子是什么搭子，我没理他。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-28", "valid_from": "2026-11-28 15:07", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-28 15:07", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "她的独唱段在汇演上稳住了", "subject": "HER", "relation": "演出", "evidence_uids": [11], "evidence_quotes": ["独唱段稳住了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 晚", "valid_from": "2026-11-29 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 21:42", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "我在台侧踩台板给她打拍子，她看见了", "subject": "ME", "relation": "演出配合", "evidence_uids": [11], "evidence_quotes": ["你在台侧踩台板给我打的拍子我看见了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 晚", "valid_from": "2026-11-29 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 21:42", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "她哥到场，鼓掌鼓得最响", "subject": "THIRD", "relation": "家人", "evidence_uids": [11], "evidence_quotes": ["我哥鼓掌鼓得最响"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 晚", "valid_from": "2026-11-29 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 21:42", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "她把散伙饭推了，说家里有事", "subject": "HER", "relation": "安排", "evidence_uids": [12], "evidence_quotes": ["散伙饭我推了，就说家里有事"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29", "valid_from": "2026-11-29 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 21:42", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "她问桥东馄饨摊周日晚上还开着吗", "subject": "HER", "relation": "提问", "evidence_uids": [12], "evidence_quotes": ["桥东那家馄饨摊，周日晚上还开着吗？"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29 晚", "valid_from": "2026-11-29 21:42", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 21:42", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "桥东馄饨摊营业到凌晨一点半，摊子开着（原“取决于开不开”已确认）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [12, 13], "evidence_quotes": ["桥东那家馄饨摊，周日晚上还开着吗？", "开着呢，我查过了，营业到凌晨一点半"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-29 23:12", "valid_to": "", "supersedes": "f_0036@v1", "origin": "reported", "plan_status": "", "ts": "2026-11-29 21:42", "history": [{"status": "proposed", "text": "今晚去桥东馄饨摊，取决于摊子开不开", "valid_to": "2026-11-29 23:12", "reason": "correct", "src_uids": [13], "quote": "开着呢，我查过了，营业到凌晨一点半"}]}, "f_0037": {"fact_id": "f_0037", "text": "桥东馄饨摊营业到凌晨一点半", "subject": "HER", "relation": "馄饨摊营业时间", "evidence_uids": [13], "evidence_quotes": ["营业到凌晨一点半"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-29", "valid_from": "2026-11-29 23:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 23:12", "history": []}, "f_0038": {"fact_id": "f_0038", "text": "九点半桥东馄饨摊见面，她请客，奶茶与夜宵一起结", "subject": "UNKNOWN", "relation": "", "evidence_uids": [13], "evidence_quotes": ["九点半桥东馄饨摊，我请"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-29 23:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-29 23:12", "history": []}}, "fact_seq": 38, "updates": [{"fact_id": "f_0023", "action": "cancel", "text": "汇演散场后他请她吃夜宵，她说到时就来（条件式提议，未敲定细节）", "old_text": "汇演散场后他请她吃夜宵，她说到时就来（条件式提议，未敲定细节）", "ts": "2026-11-26 08:26", "src_uids": [8], "quote": "昨晚的话当我没说。"}, {"fact_id": "f_0020", "action": "complete", "text": "顾星晚练独唱段练到22点后", "old_text": "顾星晚练独唱段练到22点后", "ts": "2026-11-29 21:42", "src_uids": [11], "quote": "独唱段稳住了"}, {"fact_id": "f_0027", "action": "cancel", "text": "散伙饭选哪家餐馆还没定，她说是随口问问", "old_text": "散伙饭选哪家餐馆还没定，她说是随口问问", "ts": "2026-11-29 21:42", "src_uids": [12], "quote": "散伙饭我推了"}, {"fact_id": "f_0036", "action": "correct", "text": "桥东馄饨摊营业到凌晨一点半，摊子开着（原“取决于开不开”已确认）", "old_text": "今晚去桥东馄饨摊，取决于摊子开不开", "ts": "2026-11-29 23:12", "src_uids": [13], "quote": "开着呢，我查过了，营业到凌晨一点半"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}