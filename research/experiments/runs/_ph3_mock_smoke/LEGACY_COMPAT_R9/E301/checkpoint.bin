ction_layer": true, "evidence_memory": true}, "mem": {"facts": {"f_0001": {"fact_id": "f_0001", "text": "陈默的奶茶固定三分糖去冰大杯；上周把带修订批注的评审稿误发进部门大群，被叫'批注侠'，本人认账；周一给自己下单了一把青轴键盘，快递寄到公司前台。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "周雨桐刚交完季度汇报，前后改到第十四版，文件名'汇报_最终版_打死不改版'在组里成了段子；楼下奶茶店工作日下午有第二杯半价活动。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "同组两年，互相带过奶茶带过饭，玩笑开得起，但都不过界。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "她管陈默叫'陈工'，消息短句多，爱用夸张比喻；要谈正事时会先说'说正经的'。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "陈默，后端工程师，入职三年、话少，接梗稳、奶茶只喝三分糖去冰、上周把带批注的评审稿误发进大群，得名'批注侠'", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "周雨桐，测试工程师，和陈默同组、爱凑优惠拼单、说话夸张，爱自造文件名式段子、小额账目当次结清，底线：不占同事便宜，欠的当场结清、下班后非急事不追着问", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}}, "fact_seq": 6, "updates": []}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}