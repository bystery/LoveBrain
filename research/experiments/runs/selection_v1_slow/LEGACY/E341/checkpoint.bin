ed", "event_time": "", "valid_from": "2026-11-18 21:47", "valid_to": "2026-11-19 19:37", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-18 21:47", "history": [{"status": "proposed", "text": "谁先看到凤头䴙䴘换冬羽谁带新人，输的请观鸟屋门口那家咖啡", "valid_to": "2026-11-19 19:37", "reason": "cancel", "src_uids": [3], "quote": "赌约作废"}]}, "f_0015": {"fact_id": "f_0015", "text": "她接下来两个周六都在所里做年审", "subject": "HER", "relation": "日程", "evidence_uids": [3], "evidence_quotes": ["接下来两个周六我全在所里"], "certainty": "confirmed", "status": "confirmed", "event_time": "接下来两个周六", "valid_from": "2026-11-19 19:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 19:37", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "她让北湖不用等她，组里的活我多担着", "subject": "HER", "relation": "安排", "evidence_uids": [3], "evidence_quotes": ["北湖你别等我，组里的活你多担着"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-19 19:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 19:37", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "咖啡债先挂着，回来再算", "subject": "UNKNOWN", "relation": "", "evidence_uids": [3], "evidence_quotes": ["咖啡债先挂着，回来再算"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-19 19:37", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-19 19:37", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她二十三點四十还在做审计底稿，做到第七盒", "subject": "HER", "relation": "工作状态", "evidence_uids": [5], "evidence_quotes": ["二十三点四十，审计底稿第七盒。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-24 23:40", "valid_from": "2026-11-24 23:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 23:47", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "她买了关东煮", "subject": "HER", "relation": "宵夜", "evidence_uids": [5], "evidence_quotes": ["关东煮买了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-24 23:40", "valid_from": "2026-11-24 23:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 23:47", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "我提醒她楼下便利店有关东煮，别啃冷盒饭", "subject": "ME", "relation": "提议", "evidence_uids": [4], "evidence_quotes": ["楼下便利店有关东煮，别啃冷盒饭了。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-24 23:20", "valid_from": "2026-11-24 23:47", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-24 23:47", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "东郊苗圃有斑头鸺鹠，在老槐树从东数第三棵，坐标已发给傅临川", "subject": "HER", "relation": "点位信息", "evidence_uids": [6], "evidence_quotes": ["东郊苗圃那只斑头鸺鹠，老槐树从东数第三棵，坐标发你了。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-26 21:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 21:57", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "这个点位全组只有老驰知道，现在多了傅临川", "subject": "HER", "relation": "知情人范围", "evidence_uids": [6], "evidence_quotes": ["全组就老驰知道，现在多你一个。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-26 21:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 21:57", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "她嘱咐半夜去看穿深色、别开手电", "subject": "HER", "relation": "嘱咐", "evidence_uids": [6], "evidence_quotes": ["半夜去看记得穿深色，别开手电。"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-26 21:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 21:57", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "她加班第七天", "subject": "HER", "relation": "工作状态", "evidence_uids": [6], "evidence_quotes": ["加班第七天"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-26", "valid_from": "2026-11-26 21:57", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-26 21:57", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她的年审提前收尾，底稿全归档，下周一才算缓过来", "subject": "HER", "relation": "工作安排", "evidence_uids": [7], "evidence_quotes": ["年审提前收尾了，底稿全归档，下周一我才算活过来"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-27", "valid_from": "2026-11-27 20:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-27 20:17", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "今晚她请吃饭庆祝，地点由我挑", "subject": "SHARED", "relation": "约定", "evidence_uids": [7], "evidence_quotes": ["今晚出来吃饭，我请，庆祝我从数字里活着出来——地点你挑"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-27 晚", "valid_from": "2026-11-27 20:17", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-27 20:17", "history": []}}, "fact_seq": 26, "updates": [{"fact_id": "f_0014", "action": "cancel", "text": "谁先看到凤头䴙䴘换冬羽谁带新人，输的请观鸟屋门口那家咖啡", "old_text": "谁先看到凤头䴙䴘换冬羽谁带新人，输的请观鸟屋门口那家咖啡", "ts": "2026-11-19 19:37", "src_uids": [3], "quote": "赌约作废"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}