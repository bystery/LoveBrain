otes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "称呼山月，说话带菜价和斤两，爱用‘你这眼神不行’开头嫌弃。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "早市搭子偏熟，单独接触刚从早市延伸到回家同走。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:stage", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "邵山月，力气大提得动、不识菜但听指挥、话不多递袋子快", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "丰南乔，会挑菜、嘴上嫌弃但收照顾、给家里人做饭多，底线：不轻易让人送回家、不收来路不明的贵食材", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "她说上次我挑的菠菜太老", "subject": "HER", "relation": "打趣旧事", "evidence_uids": [0], "evidence_quotes": ["上次你挑那把菠菜老得能扫地"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-07 07:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 07:38", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "今天她挑菜、我提袋子", "subject": "UNKNOWN", "relation": "", "evidence_uids": [0, 3], "evidence_quotes": ["今天跟着我，我挑你提，公平吧？", "这袋菜咱俩分了吧，你提重的我提轻的，到家门口再分"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-07 07:38", "valid_to": "2026-11-07 09:08", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 07:38", "history": [{"status": "proposed", "text": "今天她挑菜、我提袋子", "valid_to": "2026-11-07 09:08", "reason": "complete", "src_uids": [3], "quote": "这袋菜咱俩分了吧，你提重的我提轻的，到家门口再分"}]}, "f_0010": {"fact_id": "f_0010", "text": "她挑了十二个鸡蛋让邵山月提着", "subject": "HER", "relation": "早市分工", "evidence_uids": [1], "evidence_quotes": ["这筐鸡蛋我挑了十二个，你帮我提着"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 早上", "valid_from": "2026-11-07 08:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 08:08", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "她说上次小橡帮邵山月提漏过一袋土豆", "subject": "THIRD", "relation": "旧事", "evidence_uids": [1], "evidence_quotes": ["上次小橡帮你提漏过一袋土豆"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-07 08:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 08:08", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她让我帮她杀这条鲈鱼，摊主忙不过来", "subject": "HER", "relation": "请求", "evidence_uids": [2], "evidence_quotes": ["这条鲈鱼你帮我杀一下？"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 08:30", "valid_from": "2026-11-07 08:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 08:38", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她说鱼杀得还行、鳞刮得干净", "subject": "HER", "relation": "评价", "evidence_uids": [3], "evidence_quotes": ["鱼你杀得还行，鳞刮得干净"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 上午", "valid_from": "2026-11-07 09:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 09:08", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "这袋菜两人分：她提轻的、我提重的，到家门口再分，分我一份当谢礼", "subject": "SHARED", "relation": "约定", "evidence_uids": [3], "evidence_quotes": ["这袋菜咱俩分了吧，你提重的我提轻的，到家门口再分"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 上午", "valid_from": "2026-11-07 09:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 09:08", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "她想顺路带一块南头那家的豆腐，说那家卤豆腐做得好", "subject": "HER", "relation": "偏好", "evidence_uids": [4], "evidence_quotes": ["我想顺路带一块，他家卤豆腐做得好"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 上午", "valid_from": "2026-11-07 09:35", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 09:35", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "她打算顺路去南头豆腐摊买一块豆腐（是否出摊未知）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [4], "evidence_quotes": ["我想顺路带一块"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 09:35", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 09:35", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她昨天把鲈鱼做了红烧，她妈说比上回她自己杀的腥味小", "subject": "HER", "relation": "家常", "evidence_uids": [5], "evidence_quotes": ["昨天那顿鲈鱼我做了红烧，我妈说比上回我自己杀的腥味小。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-08", "valid_from": "2026-11-09 08:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 08:58", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她跟她妈说是早市一位师傅帮的忙，她妈问住哪栋，她只说同小区", "subject": "HER", "relation": "家人对话", "evidence_uids": [5], "evidence_quotes": ["我跟她说是早市一位师傅帮的忙，她问你住哪栋——我没多说，就说同小区的。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 08:50", "valid_from": "2026-11-09 08:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 08:58", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "她下班路过早市收摊，替我买了一小把香葱，放在我门口", "subject": "HER", "relation": "送东西", "evidence_uids": [6], "evidence_quotes": ["我替你买了一小把——你一个人做饭用得着吧？放你门口了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 18:30", "valid_from": "2026-11-11 18:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 18:38", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "小橡这周加班，不来早市", "subject": "THIRD", "relation": "早市同行者", "evidence_uids": [7], "evidence_quotes": ["小橡这周加班不来"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15 周六", "valid_from": "2026-11-13 19:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:08", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "她新发现一个卖土鸡的摊子，路有点远", "subject": "HER", "relation": "早市摊子", "evidence_uids": [7], "evidence_quotes": ["我新发现个摊子卖土鸡，路有点远"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 19:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:08", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "周六早市同去，由我帮忙把土鸡扛回来（具体时间未定）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7, 8], "evidence_quotes": ["这周六早市还去吗？", "今天这只土鸡你帮我挑的"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-13 19:08", "valid_to": "2026-11-14 08:28", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:08", "history": [{"status": "proposed", "text": "周六早市同去，由我帮忙把土鸡扛回来（具体时间未定）", "valid_to": "2026-11-14 08:28", "reason": "complete", "src_uids": [8], "quote": "今天这只土鸡你帮我挑的"}]}, "f_0023": {"fact_id": "f_0023", "text": "她说今天这只土鸡是我帮她挑的，老板说养了八个月，脚爪硬，比上次那只强", "subject": "HER", "relation": "早市搭子", "evidence_uids": [8], "evidence_quotes": ["今天这只土鸡你帮我挑的，老板说养了八个月，我看脚爪硬，比上次那只强"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 早上", "valid_from": "2026-11-14 08:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 08:28", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "她说这鸡炖汤够两个人喝，她家就她和她妈喝不完", "subject": "HER", "relation": "家里情况", "evidence_uids": [8], "evidence_quotes": ["这鸡炖汤够两个人喝，我家就我和我妈喝不完"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 早上", "valid_from": "2026-11-14 08:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 08:28", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她提出分我半只土鸡，算咱俩一起买的", "subject": "UNKNOWN", "relation": "", "evidence_uids": [8], "evidence_quotes": ["分你半只吧，你那口锅炖得下，算咱俩一起买的"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 08:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 08:28", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "早市出来往西走有个早点铺", "subject": "HER", "relation": "地点", "evidence_uids": [9], "evidence_quotes": ["早市出来往西走有个早点铺"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 09:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 09:38", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "她提议去早点铺喝豆浆歇会儿，我请豆浆她请油条（未敲定）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [9, 10], "evidence_quotes": ["你请我喝豆浆，我请你吃油条，公平", "豆浆喝完了"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-14 09:38", "valid_to": "2026-11-14 10:18", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 09:38", "history": [{"status": "proposed", "text": "她提议去早点铺喝豆浆歇会儿，我请豆浆她请油条（未敲定）", "valid_to": "2026-11-14 10:18", "reason": "complete", "src_uids": [10], "quote": "豆浆喝完了"}]}, "f_0028": {"fact_id": "f_0028", "text": "她提议我一个人做饭没头绪时喊她，她教我挑菜（未敲定）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [10], "evidence_quotes": ["下回你要是一个人做饭没头绪，喊我一声，我教你怎么挑"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 10:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 10:18", "history": []}}, "fact_seq": 28, "updates": [{"fact_id": "f_0009", "action": "complete", "text": "今天她挑菜、我提袋子", "old_text": "今天她挑菜、我提袋子", "ts": "2026-11-07 09:08", "src_uids": [3], "quote": "这袋菜咱俩分了吧，你提重的我提轻的，到家门口再分"}, {"fact_id": "f_0022", "action": "complete", "text": "周六早市同去，由我帮忙把土鸡扛回来（具体时间未定）", "old_text": "周六早市同去，由我帮忙把土鸡扛回来（具体时间未定）", "ts": "2026-11-14 08:28", "src_uids": [8], "quote": "今天这只土鸡你帮我挑的"}, {"fact_id": "f_0027", "action": "complete", "text": "她提议去早点铺喝豆浆歇会儿，我请豆浆她请油条（未敲定）", "old_text": "她提议去早点铺喝豆浆歇会儿，我请豆浆她请油条（未敲定）", "ts": "2026-11-14 10:18", "src_uids": [10], "quote": "豆浆喝完了"}]}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "kbin:stage": "f_0005", "persona:me": "f_0006", "persona:her": "f_0007"}}