me", "plan_status": "", "ts": "", "history": []}, "f_0002": {"fact_id": "f_0002", "text": "储晚舟爱拍人不爱被拍，嘴上调侃，给舒子川拍过两张满意的，外拍偶遇三次。", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "外拍搭子三次，她拍他配合，互损两句，第三次开始约着同去取景。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "称呼子川，说话带光圈快门，爱用‘你这角度不行’开头损人。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "外拍搭子偏熟，单独接触刚从群拍延伸到两人同去。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:stage", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "舒子川，取景稳、会借光、不抢拍她不乐意的", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "储晚舟，爱拍人不爱被拍、嘴上调侃但记得光影、给人拍好看会得意，底线：不轻易让人拍自己正脸、不收来路不明的镜头", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "她提议让他站上次那个位置，给他拍一组", "subject": "UNKNOWN", "relation": "", "evidence_uids": [0], "evidence_quotes": ["你再站那个位置，我给你来一组"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 15:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 15:08", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "她提出借我的 50 定焦，用她的变焦跟我换用", "subject": "HER", "relation": "器材互换提议", "evidence_uids": [1], "evidence_quotes": ["你那个50定焦借我用用？我带的变焦不够锐，你这颗出片肉感正好。换你用我的变焦，公平吧？"], "certainty": "tentative", "status": "tentative", "event_time": "2026-11-07 15:40", "valid_from": "2026-11-07 15:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 15:48", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "50 定焦与变焦互换使用（未敲定）", "subject": "UNKNOWN", "relation": "", "evidence_uids": [1], "evidence_quotes": ["换你用我的变焦，公平吧？"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 15:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 15:48", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "她相机电池快没电，问有没有备用电池可借", "subject": "HER", "relation": "外拍现场需求", "evidence_uids": [2], "evidence_quotes": ["我相机电池快没了，你带备用没？借一块"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 16:10", "valid_from": "2026-11-07 16:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 16:18", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "若没有备用电池，她可能就此收工", "subject": "UNKNOWN", "relation": "", "evidence_uids": [2], "evidence_quotes": ["要是你没有就算了，我收工也行，今天光线也快过去了。"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 16:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 16:18", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她拍的这组修好后发给我", "subject": "UNKNOWN", "relation": "", "evidence_uids": [3], "evidence_quotes": ["这组我给你拍的，回头修好发你"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 16:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 16:48", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "两人互相当模特，她也修我给她拍的那些", "subject": "UNKNOWN", "relation": "", "evidence_uids": [3], "evidence_quotes": ["你给我拍的我也修，咱俩互相当模特"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 16:48", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 16:48", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "老驰下周也来这个机位", "subject": "THIRD", "relation": "群里的人", "evidence_uids": [4], "evidence_quotes": ["群里老驰说他下周也来这个机位"], "certainty": "tentative", "status": "tentative", "event_time": "下周", "valid_from": "2026-11-07 17:25", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 17:25", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "她把那张逆光侧脸调成了暖调", "subject": "HER", "relation": "修图", "evidence_uids": [5], "evidence_quotes": ["那张逆光侧脸我调了暖调"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 21:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 21:08", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她把自己那张正脸也修了，觉得比预期好", "subject": "HER", "relation": "修图", "evidence_uids": [5], "evidence_quotes": ["你给我拍的那张我也修了，我那张正脸拍得比我预期好"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 21:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 21:08", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她今晚下班路过河边，灯刚亮时随手拍了我两张背影", "subject": "HER", "relation": "外拍搭子", "evidence_uids": [6], "evidence_quotes": ["今晚下班路过河边，灯刚亮那会儿光不错。我随手给你拍了两张背影，你没发现。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 傍晚", "valid_from": "2026-11-11 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:38", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "她说回头发我这两张背影", "subject": "HER", "relation": "外拍搭子", "evidence_uids": [6], "evidence_quotes": ["回头发你，你看看要不要"], "certainty": "tentative", "status": "tentative", "event_time": "", "valid_from": "2026-11-11 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:38", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "她回头把这两张背影发我", "subject": "UNKNOWN", "relation": "", "evidence_uids": [6], "evidence_quotes": ["回头发你，你看看要不要"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-11 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:38", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "她新买了一个85定，想试人像", "subject": "HER", "relation": "器材/拍摄计划", "evidence_uids": [7], "evidence_quotes": ["我新买了个85定，想试试人像"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 18:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:58", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "她让我当模特，公平起见我拍她，她只让拍侧脸，正脸不行", "subject": "HER", "relation": "拍摄边界", "evidence_uids": [7], "evidence_quotes": ["你当模特——公平起见你也拍我，我让你拍侧脸，正脸还是不行"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-13 18:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:58", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "小葳这周六有事，去不了", "subject": "THIRD", "relation": "同行安排", "evidence_uids": [7], "evidence_quotes": ["小葳说她有事"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-15", "valid_from": "2026-11-13 18:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:58", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "这周六两人一起去外拍", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7], "evidence_quotes": ["这周六还去吗？小葳说她有事，就咱俩？"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-13 18:58", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:58", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她今天这组是用85拍的，虚化比50狠很多", "subject": "HER", "relation": "拍摄器材与效果", "evidence_uids": [8], "evidence_quotes": ["今天这组我用85拍的，虚化比50狠多了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14", "valid_from": "2026-11-14 15:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 15:38", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "她说我那张侧脸我想要来当头像", "subject": "SHARED", "relation": "照片用途", "evidence_uids": [8], "evidence_quotes": ["你那张侧脸我让你看了，你说你想要那张当头像？"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 15:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 15:38", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "她修两版（一暖一冷）让我挑", "subject": "UNKNOWN", "relation": "", "evidence_uids": [8], "evidence_quotes": ["我给你修两版，一暖一冷，你挑"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 15:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 15:38", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "她邀我去河边小馆子坐会儿，她请喝东西谢模特", "subject": "HER", "relation": "邀约", "evidence_uids": [9], "evidence_quotes": ["河边那个小馆子坐会儿？我请你喝东西，算谢模特"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 傍晚", "valid_from": "2026-11-14 17:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 17:08", "history": []}, "f_0029": {"fact_id": "f_0029", "text": "她下回让我拍她的手和背影，正脸还是不行", "subject": "HER", "relation": "拍摄边界", "evidence_uids": [10], "evidence_quotes": ["下回你要是想拍我，我让你拍手和背影，正脸还是不行"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 18:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 18:28", "history": []}, "f_0030": {"fact_id": "f_0030", "text": "她说我拍得好就考虑给我拍一次半侧，只一次", "subject": "HER", "relation": "拍摄边界", "evidence_uids": [10], "evidence_quotes": ["不过你要是拍得好，我考虑给你拍一次半侧。就一次啊，别得寸进尺。"], "certainty": "tentative", "status": "tentative", "event_time": "", "valid_from": "2026-11-14 18:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 18:28", "history": []}, "f_0031": {"fact_id": "f_0031", "text": "下回拍她的手和背影", "subject": "UNKNOWN", "relation": "", "evidence_uids": [10], "evidence_quotes": ["下回你要是想拍我，我让你拍手和背影"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 18:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 18:28", "history": []}, "f_0032": {"fact_id": "f_0032", "text": "拍得好可能给一次半侧", "subject": "UNKNOWN", "relation": "", "evidence_uids": [10], "evidence_quotes": ["我考虑给你拍一次半侧"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 18:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 18:28", "history": []}, "f_0033": {"fact_id": "f_0033", "text": "她说她到家了", "subject": "HER", "relation": "状态", "evidence_uids": [11], "evidence_quotes": ["到家了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 21:30", "valid_from": "2026-11-14 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 21:38", "history": []}, "f_0034": {"fact_id": "f_0034", "text": "她让我定了冷调头像发她，她出大图", "subject": "HER", "relation": "约定", "evidence_uids": [11], "evidence_quotes": ["那张冷调头像你定了发我，我给你出大图"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 21:38", "history": []}, "f_0035": {"fact_id": "f_0035", "text": "下回外拍她带三脚架，用定时拍合一张，我按快门", "subject": "UNKNOWN", "relation": "", "evidence_uids": [11], "evidence_quotes": ["下回外拍我带三脚架，咱俩合一张——用定时拍，我不让别人拍，你按快门行"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 21:38", "history": []}, "f_0036": {"fact_id": "f_0036", "text": "合一张算咱俩外拍三周的纪念", "subject": "UNKNOWN", "relation": "", "evidence_uids": [11], "evidence_quotes": ["合一张算咱俩外拍三周的纪念"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 21:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 21:38", "history": []}}, "fact_seq": 36, "updates": []}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "kbin:stage": "f_0005", "persona:me": "f_0006", "persona:her": "f_0007"}}