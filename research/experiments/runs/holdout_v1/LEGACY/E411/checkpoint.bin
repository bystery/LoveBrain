], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:her", "plan_status": "", "ts": "", "history": []}, "f_0003": {"fact_id": "f_0003", "text": "同桌三周，递工具顺手，课中会挨着站，谁都晓得有点什么，谁都没说破。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:warmth", "plan_status": "", "ts": "", "history": []}, "f_0004": {"fact_id": "f_0004", "text": "叫他越老师是打趣，说话带具体克数和步骤，爱用‘你别笑话我’开头。", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "普通同学偏熟，单独接触刚从课堂延伸到课后微信。", "subject": "SHARED", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:stage", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "越千山，手稳话少、烘焙课里抹面最平、不主动点破", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "郁念慈，做事细致、嘴上不饶人但心软、对人照顾周到，底线：不轻易答应带回家的事、受了照顾一定回礼", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "郁念慈说她抹面总往一边歪，陈老师说她的手腕没收住", "subject": "HER", "relation": "烘焙课抹面手法问题", "evidence_uids": [0], "evidence_quotes": ["我那个总往一边歪，陈老师说我手腕没收住。"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 下午", "valid_from": "2026-11-07 14:15", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 14:15", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "郁念慈请越千山待会儿帮她看抹面手法哪里不对", "subject": "HER", "relation": "课堂内的请求", "evidence_uids": [0], "evidence_quotes": ["待会儿帮我看看哪里手法不对呗？"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 下午", "valid_from": "2026-11-07 14:15", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 14:15", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "待会儿课上帮她看抹面手法", "subject": "UNKNOWN", "relation": "", "evidence_uids": [0], "evidence_quotes": ["待会儿帮我看看哪里手法不对呗？"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 14:15", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 14:15", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "她把多打的奶油匀一半给我", "subject": "HER", "relation": "课上互助", "evidence_uids": [1], "evidence_quotes": ["匀你一半"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 15:20", "valid_from": "2026-11-07 15:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 15:26", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她帮我盯着烤箱温度和我那盘的出炉时间", "subject": "HER", "relation": "课上互助", "evidence_uids": [1], "evidence_quotes": ["烤箱温度我也帮你盯着"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 15:20", "valid_from": "2026-11-07 15:26", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 15:26", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "郁念慈的电子秤没电了，想借越千山的秤用", "subject": "HER", "relation": "借物", "evidence_uids": [2], "evidence_quotes": ["你那个电子秤借我用一下？我的没电了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 下午", "valid_from": "2026-11-07 16:35", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 16:35", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "陈老师说司康这一步克数卡得严", "subject": "THIRD", "relation": "课堂指导", "evidence_uids": [2], "evidence_quotes": ["陈老师说司康这步克数卡得严"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 下午", "valid_from": "2026-11-07 16:35", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 16:35", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "她那盒曲奇烤糊了三块", "subject": "HER", "relation": "烘焙课作品", "evidence_uids": [3], "evidence_quotes": ["我那盒曲奇烤糊了三块"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 17:05", "valid_from": "2026-11-07 17:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 17:12", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "剩下的曲奇给越千山带回去", "subject": "UNKNOWN", "relation": "", "evidence_uids": [3], "evidence_quotes": ["剩下的你带回去？"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-07 17:12", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 17:12", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "郁念慈说她的笔记没抄全，翻半天没找到司康配方那页", "subject": "HER", "relation": "课堂笔记", "evidence_uids": [4], "evidence_quotes": ["我笔记没抄全，翻半天没翻到那页"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-07 18:40", "valid_from": "2026-11-07 18:46", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-07 18:46", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她说：今天单位那位同事问我曲奇哪买的，我说是朋友做的", "subject": "HER", "relation": "同事对话", "evidence_uids": [5], "evidence_quotes": ["今天单位那位同事问我曲奇哪买的，我说是朋友做的"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 20:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 20:18", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "她说：她还不信，说朋友哪能烤这么齐", "subject": "HER", "relation": "同事对话", "evidence_uids": [5], "evidence_quotes": ["她还不信，说朋友哪能烤这么齐"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09", "valid_from": "2026-11-09 20:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 20:18", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "下次让同事也尝尝曲奇", "subject": "UNKNOWN", "relation": "", "evidence_uids": [5], "evidence_quotes": ["我跟她说下次让她也尝尝"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-09 20:18", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 20:18", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "郁念慈多做了一个三明治放在前台，让越千山回头去拿", "subject": "HER", "relation": "照顾/带饭", "evidence_uids": [6], "evidence_quotes": ["我多做了个三明治放前台了，你回头拿"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 中午", "valid_from": "2026-11-10 12:55", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:55", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "今天轮到越千山盯烤箱", "subject": "ME", "relation": "烘焙课分工", "evidence_uids": [6], "evidence_quotes": ["今天轮你盯烤箱"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 12:55", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:55", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "小葳下周不来上烘焙课，她那桌只剩她一个人", "subject": "THIRD", "relation": "烘焙班同学", "evidence_uids": [7], "evidence_quotes": ["小葳说她下周不来，我那桌就剩我一个人了"], "certainty": "confirmed", "status": "confirmed", "event_time": "下周", "valid_from": "2026-11-12 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 19:38", "history": []}, "f_0024": {"fact_id": "f_0024", "text": "周六搬到越千山旁边坐", "subject": "UNKNOWN", "relation": "", "evidence_uids": [7], "evidence_quotes": ["我搬你旁边坐得了"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-12 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 19:38", "history": []}, "f_0025": {"fact_id": "f_0025", "text": "她说妈妈尝了上周那盒曲奇说不错，问她是不是班里那个手艺好的男生做的，她没否认", "subject": "HER", "relation": "她妈妈对曲奇的评价与追问", "evidence_uids": [8], "evidence_quotes": ["上周那盒曲奇我妈尝了一块说不错，问我是不是班里那个手艺好的男生做的，我没否认"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-14 14:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 14:28", "history": []}, "f_0026": {"fact_id": "f_0026", "text": "她说回头给你带两块让她对比对比", "subject": "UNKNOWN", "relation": "", "evidence_uids": [8], "evidence_quotes": ["只说回头给你带两块让她对比对比"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-14 14:28", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 14:28", "history": []}, "f_0027": {"fact_id": "f_0027", "text": "她让我帮她把戚风底托扶稳", "subject": "HER", "relation": "课堂请求", "evidence_uids": [9], "evidence_quotes": ["你帮我把底托扶稳，我手不够用"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-14 下午", "valid_from": "2026-11-14 16:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-14 16:08", "history": []}, "f_0028": {"fact_id": "f_0028", "text": "弄完她请我喝杯东西", "subject": "UNKNOWN", "relation": "", "evidence_uids": [9, 10], "evidence_quotes": ["弄完我请你喝杯东西，就当谢师傅", "刚才那杯还行吧"], "certainty": "tentative", "status": "completed", "event_time": "", "valid_from": "2026-11-14 16:08", "valid_to": "2026-11-14 18:1