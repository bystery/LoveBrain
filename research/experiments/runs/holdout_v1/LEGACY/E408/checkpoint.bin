 "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "kbin:style", "plan_status": "", "ts": "", "history": []}, "f_0005": {"fact_id": "f_0005", "text": "堵其琛，不会做饭但洗碗勤快、嘴笨但行动到位、对若云有好感但不善表达", "subject": "ME", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:me", "plan_status": "", "ts": "", "history": []}, "f_0006": {"fact_id": "f_0006", "text": "麴若云，厨艺好且爱投喂、嘴上不饶人但心软、用做饭照顾人，底线：不接受被嫌做饭难吃、厨房是她的地盘", "subject": "HER", "relation": "", "evidence_uids": [], "evidence_quotes": [], "certainty": "confirmed", "status": "confirmed_seed", "event_time": "", "valid_from": "", "valid_to": "", "supersedes": "", "origin": "persona:her", "plan_status": "", "ts": "", "history": []}, "f_0007": {"fact_id": "f_0007", "text": "若云今晚做了红烧排骨，其琛那碗多了两块", "subject": "HER", "relation": "晚饭", "evidence_uids": [0], "evidence_quotes": ["其琛今晚做了红烧排骨，你那碗多了两块"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 晚", "valid_from": "2026-11-09 19:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:08", "history": []}, "f_0008": {"fact_id": "f_0008", "text": "她让堵其琛尝咸淡，并说今早看到他冰箱里那盒外卖剩了一半，叮嘱他别吃隔夜、胃不好别逞能", "subject": "HER", "relation": "关心/叮嘱", "evidence_uids": [1], "evidence_quotes": ["你尝尝咸淡，我今早看你冰箱里那盒外卖剩了一半，以后别吃隔夜的了，胃不好别逞能"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-09 19:30", "valid_from": "2026-11-09 19:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-09 19:38", "history": []}, "f_0009": {"fact_id": "f_0009", "text": "老茅约她去吃饭，她没去，嫌远", "subject": "HER", "relation": "饭局邀请", "evidence_uids": [2], "evidence_quotes": ["老茅约我去他那儿吃饭我没去，嫌远"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10", "valid_from": "2026-11-10 12:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 12:08", "history": []}, "f_0010": {"fact_id": "f_0010", "text": "若云今晚做了番茄牛腩", "subject": "HER", "relation": "做饭投喂", "evidence_uids": [3], "evidence_quotes": ["今晚做了你上次说想吃的番茄牛腩"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 晚", "valid_from": "2026-11-10 18:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 18:38", "history": []}, "f_0011": {"fact_id": "f_0011", "text": "若云称其琛上周说过想吃番茄牛腩，她记着", "subject": "HER", "relation": "记着他的口味", "evidence_uids": [3], "evidence_quotes": ["记得吗上周你说嘴馋的那个，我记着呢"], "certainty": "confirmed", "status": "confirmed", "event_time": "", "valid_from": "2026-11-10 18:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 18:38", "history": []}, "f_0012": {"fact_id": "f_0012", "text": "她让其琛别用洗碗机，碗少就手洗省电", "subject": "HER", "relation": "日常安排", "evidence_uids": [4], "evidence_quotes": ["你碗洗了没，今天碗少就别用洗碗机了，手洗吧，省点电"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-10 20:00", "valid_from": "2026-11-10 20:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-10 20:08", "history": []}, "f_0013": {"fact_id": "f_0013", "text": "她今晚把菜温着，锅里那碗是留给我的，她自己那碗已经吃完了", "subject": "HER", "relation": "晚饭安排", "evidence_uids": [5], "evidence_quotes": ["菜给你温着呢，锅里那碗是你的，我那碗已经吃完了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 晚", "valid_from": "2026-11-11 19:23", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:23", "history": []}, "f_0014": {"fact_id": "f_0014", "text": "她让我别像昨晚那样拿外卖凑合", "subject": "HER", "relation": "叮嘱", "evidence_uids": [5], "evidence_quotes": ["别跟昨晚似的拿外卖凑合"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11 晚", "valid_from": "2026-11-11 19:23", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 19:23", "history": []}, "f_0015": {"fact_id": "f_0015", "text": "小隼来借东西时看到餐桌上有两副碗筷，问若云是不是有对象", "subject": "THIRD", "relation": "若云提到的第三人", "evidence_uids": [6], "evidence_quotes": ["今天小隼来借东西看到餐桌上有两副碗筷，问我是不是有对象了"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-11 21:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:08", "history": []}, "f_0016": {"fact_id": "f_0016", "text": "若云回答小隼说自己只是室友", "subject": "HER", "relation": "她对第三人的说法", "evidence_uids": [6], "evidence_quotes": ["我说就是室友"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-11", "valid_from": "2026-11-11 21:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-11 21:08", "history": []}, "f_0017": {"fact_id": "f_0017", "text": "她问两个人每天一起吃饭算什么关系，说是好奇问问", "subject": "HER", "relation": "试探性提问", "evidence_uids": [7], "evidence_quotes": ["问你个事，你说两个人每天一起吃饭算什么关系，就是好奇问问"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 12:30", "valid_from": "2026-11-12 12:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 12:38", "history": []}, "f_0018": {"fact_id": "f_0018", "text": "她今晚不做饭，让他随便吃", "subject": "HER", "relation": "晚饭安排", "evidence_uids": [8], "evidence_quotes": ["今晚不做了，你随便吃吧"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12 晚", "valid_from": "2026-11-12 19:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-12 19:08", "history": []}, "f_0019": {"fact_id": "f_0019", "text": "她昨晚没做饭是因为被白天那个问题弄得不自在，不是不想做，需要缓缓", "subject": "HER", "relation": "状态说明", "evidence_uids": [9], "evidence_quotes": ["昨晚没做饭是因为你白天问那个问题把我弄不自在了，不是不想做，就是需要缓缓"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-12晚至2026-11-13", "valid_from": "2026-11-13 18:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:38", "history": []}, "f_0020": {"fact_id": "f_0020", "text": "她需要时间缓缓，暂不继续那个话题", "subject": "UNKNOWN", "relation": "", "evidence_uids": [9], "evidence_quotes": ["就是需要缓缓"], "certainty": "tentative", "status": "proposed", "event_time": "", "valid_from": "2026-11-13 18:38", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 18:38", "history": []}, "f_0021": {"fact_id": "f_0021", "text": "若云今晚炖了鸡汤，给其琛那碗多放了红枣", "subject": "HER", "relation": "做饭投喂", "evidence_uids": [10], "evidence_quotes": ["今晚炖了鸡汤，你的那碗多放了红枣"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13 晚", "valid_from": "2026-11-13 19:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:08", "history": []}, "f_0022": {"fact_id": "f_0022", "text": "其琛上周说过最近累", "subject": "ME", "relation": "她转述", "evidence_uids": [10], "evidence_quotes": ["你上周说最近累"], "certainty": "confirmed", "status": "confirmed", "event_time": "上周", "valid_from": "2026-11-13 19:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 19:08", "history": []}, "f_0023": {"fact_id": "f_0023", "text": "她说从堵其琛搬进来第一顿饭起就多盛一份给他，当时说是炖多了", "subject": "HER", "relation": "照顾/示好", "evidence_uids": [11], "evidence_quotes": ["其实从你搬进来第一顿饭我就多盛了一份给你，你那天还问为什么多一碗，我说炖多了，跟今天一样的话"], "certainty": "confirmed", "status": "confirmed", "event_time": "2026-11-13 22:00", "valid_from": "2026-11-13 22:08", "valid_to": "", "supersedes": "", "origin": "reported", "plan_status": "", "ts": "2026-11-13 22:08", "history": []}}, "fact_seq": 23, "updates": []}, "plan_items": [], "seed_fids": {"kbin:me": "f_0001", "kbin:her": "f_0002", "kbin:warmth": "f_0003", "kbin:style": "f_0004", "persona:me": "f_0005", "persona:her": "f_0006"}}