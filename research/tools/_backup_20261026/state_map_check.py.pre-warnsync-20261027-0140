def sha256_file(path):
    import hashlib
    h = hashlib.sha256()
    with open(path, 'rb') as f:
        for chunk in iter(lambda: f.read(1 << 20), b''):
            h.update(chunk)
    return h.hexdigest()


def is_excluded_dir(name):
    return any(p.match(name) for p in EXCLUDE_DIR_PATTERNS)


def is_excluded_file(name):
    return any(p.match(name) for p in EXCLUDE_FILE_PATTERNS)


def iter_repo_files():
    """默认排除规则的仓库遍历器（检索/统计脚本应复用此规则）。"""
    for dirpath, dirnames, filenames in os.walk(ROOT):
        rel_dir = os.path.relpath(dirpath, ROOT)
        parts = [] if rel_dir == '.' else rel_dir.split(os.sep)
        dirnames[:] = [d for d in dirnames if not is_excluded_dir(d)
                       and not any(is_excluded_dir(p) for p in parts)]
        for fn in filenames:
            if is_excluded_file(fn):
                continue
            yield os.path.join(dirpath, fn)


def count_files(d):
    n = 0
    for _r, _ds, fs in os.walk(d):
        n += len(fs)
    return n


class Report(object):
    def __init__(self):
        self.ok, self.warn, self.mismatch = [], [], []

    def add(self, status, msg):
        {'OK': self.ok, 'WARN': self.warn, 'MISMATCH': self.mismatch}[status].append(msg)

    def print_all(self):
        for title, items in (('OK', self.ok), ('WARN', self.warn), ('MISMATCH', self.mismatch)):
            print('\n== %s (%d) ==' % (title, len(items)))
            for m in items:
                print('  ' + m)

    @property
    def exit_code(self):
        return 1 if self.mismatch else 0


