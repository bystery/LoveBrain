        recs = [json.loads(l) for l in open(p(*PERF_LEDGER.split('/')), encoding='utf-8') if l.strip()]
        auth = next(r for r in recs if r.get('kind') == 'authorization_scope')
        used = sum(1 for r in recs if r.get('kind') == 'attempt_started')
        cap = auth.get('max_attempts')
        judge_forbidden = auth.get('scope', {}).get('automatic_judge_generations') is False
        if used == PERF_LEDGER_USED and cap == PERF_LEDGER_CAP:
            rep.add('OK', '[账本] %s used=%d cap=%d 余=%d' % (PERF_LEDGER, used, cap, cap - used))
        else:
            rep.add('MISMATCH', '[账本] %s used=%d cap=%d ≠ 期望 used=%d cap=%d（STATE_MAP §2-A 预算行需更新）'
                    % (PERF_LEDGER, used, cap, PERF_LEDGER_USED, PERF_LEDGER_CAP))
        if judge_forbidden:
            rep.add('OK', '[账本] 性能阶段 scope 禁止 judge（automatic_judge_generations=false）')
        else:
            rep.add('MISMATCH', '[账本] 性能阶段 scope 的 judge 禁令字段异常')
    except Exception as exc:  # noqa: BLE001
        rep.add('MISMATCH', '[账本] 性能账本解析失败: %s' % exc)
    for rel, who in ((V5_LEDGER, 'v5'), (R2_LEDGER, 'r2'), (V3_LEDGER, 'v3')):
        try:
            recs = [json.loads(l) for l in open(p(*rel.split('/')), encoding='utf-8') if l.strip()]
            closed = any(r.get('kind') == 'authorization_closed' for r in recs)
            (rep.add('OK', '[账本] %s 批账本已关闭（不得复活）' % who) if closed
             else rep.add('MISMATCH', '[账本] %s 批账本缺关闭事件' % who))
        except Exception as exc:  # noqa: BLE001
            rep.add('MISMATCH', '[账本] %s 账本解析失败: %s' % (who, exc))
    for rel, who, cap_exp in CLOSED_LEDGERS_EXPECT:
        try:
            recs = [json.loads(l) for l in open(p(*rel.split('/')), encoding='utf-8') if l.strip()]
            used = sum(1 for x in recs if x.get('kind') == 'attempt_started')
            closed = any(x.get('kind') == 'authorization_closed' for x in recs)
            if used == cap_exp and closed:
                rep.add('OK', '[账本] %s CLOSED %d/%d（不得复活）' % (who, used, cap_exp))
            elif not closed:
                rep.add('MISMATCH', '[账本] %s used=%d/%d 缺关闭事件（STATE_MAP §2-A 需更新）'
                        % (who, used, cap_exp))
            else:
                rep.add('MISMATCH', '[账本] %s used=%d ≠ 期望 %d（STATE_MAP §2-A 需更新）'
                        % (who, used, cap_exp))
        except FileNotFoundError:
            rep.add('MISMATCH', '[账本] %s 账本缺失——STATE_MAP 记录该批已收口，若确未跑请更新 STATE_MAP' % who)
        except Exception as exc:  # noqa: BLE001
            rep.add('MISMATCH', '[账本] %s 解析失败: %s' % (who, exc))

    # ---- 检索排除规则自测 ----
    hits = [os.path.relpath(f, ROOT).replace(os.sep, '/') for f in iter_repo_files()
            if os.path.basename(f) == 'AUDIT_PHASE0.md']
    if hits == ['refs/AUDIT_PHASE0.md']:
        rep.add('OK', '[自测] 排除规则下 AUDIT_PHASE0.md 仅命中权威原件 1 处（不再刷屏）')
    else:
        rep.add('MISMATCH', '[自测] 排除规则失效：AUDIT_PHASE0.md 命中 %s' % hits)
    bad = [f for f in iter_repo_files()
           if 'evil_link' in f or '\\dist\\' in f or '/dist/' in f
           or 'isol_runs' in os.path.relpath(f, ROOT)]
    if bad:
        rep.add('MISMATCH', '[自测] 遍历器泄漏排除目录/诱饵路径 %d 个，示例: %s' % (len(bad), bad[:3]))
    else:
        rep.add('OK', '[自测] 遍历器不泄漏 dist/isol_runs/evil_link')

    # ---- STATE_MAP 本体存在 ----
    if os.path.isfile(STATE_MAP):
        rep.add('OK', '[A] STATE_MAP_20261025.md 在位')
    else:
        rep.add('MISMATCH', '[A] STATE_MAP_20261025.md 缺失')

    rep.print_all()
    print('\nSUMMARY: ok=%d warn=%d mismatch=%d exit=%d'
          % (len(rep.ok), len(rep.warn), len(rep.mismatch), rep.exit_code))
    if args.json:
        with open(args.json, 'w', encoding='utf-8') as f:
            json.dump({'ok': rep.ok, 'warn': rep.warn, 'mismatch': rep.mismatch},
                      f, ensure_ascii=False, indent=1)
        print('json -> %s' % args.json)
    sys.exit(rep.exit_code)


if __name__ == '__main__':
    main()
