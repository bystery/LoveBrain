      "turn_type": "reply",
      "gold": {},
      "feedback": {},
      "input": {
        "messages": [
          {"role": "HER", "ts": "2026-11-12 19:36", "text": "庾医生查房说周五能出院。出院小结、医保结算，还有租的轮椅要还三楼租借处。我爸非说自己能走，刚才下床走两步就扶墙，倔得跟我小时候一个样。"}
        ],
        "clock": "2026-11-12 19:45",
