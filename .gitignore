# Gradle / Android
.gradle
/build
/app/build
/captures
.externalNativeBuild
.cxx
*.iml

# Local configuration (machine-specific)
/local.properties
local.properties

# IDE
/.idea
.DS_Store

# Logs / temp
*.log
*.tmp

# 本地文档目录（内部需求/避坑/迁移/指导书等，一律不入库）
#
# 例外：README / BENCHMARK / CI 步骤直接引用的**证据文档**必须入库，否则公开仓库里
# 会出现死链、CI 的 `asset_hashes.sh --check docs/prompt-assets.lock` 也会因为拿不到
# 锁文件而失败。以前这里整目录排除，导致 2026-09-23 复核报告 §7.3 说的"文档链接指向
# 仓库里不存在的东西"。用 /docs/* 而不是 /docs/，否则 git 不允许重新纳入子文件。
/docs/*
!/docs/PRIVACY-THREAT-MODEL.md
!/docs/prompt-assets.lock
!/docs/RELEASE_CHECKLIST.md
!/docs/CANCELLATION-AUDIT.md

# 内部阶段审计/指导书（只存项目管理系统，不入公开仓库）
LoveBrain_Phase*_*.md

# AI tool cache
/.qoder/*
!/.qoder/agents/
!/.qoder/skills/

# Debug screenshots (may contain real chat content - privacy, never commit)
/scr1.png
*.png.tmp

# Local knowledge base data (contains real chat content - privacy redline, never commit; )
/knowledge_base/
# checker build artifacts ()
/.checker_build/
# worker/checker 基线证据存档与返工留档（批内临时，不入库）
/.baseline_*/
/.worker_rework/

# 冒烟/物料交接文件夹（本地协作用，不入库）
/待补物料/

# WorkBuddy 工作区数据（会话级 memory + 临时脚本，不入库）
/.workbuddy/

# 营销发帖草稿（内部物料，不入库）
/marketing/

# 正式签名 keystore 与密码配置（绝不入库）
/keystore/
/keystore.properties

# benchmark 本地测试资产（只入库 BENCHMARK.md，不入库脚本/数据/key）
/benchmark/

# 云盘上传临时分片（体积大，不入库）
/.tmp.driveupload/

# APK 发布产物（使用 GitHub Releases，不入源码仓库）
/dist/
*.apk

# 构建/检查结果日志（本地留档，不入库）
/lint_results.txt
/release_results.txt
/test_results.txt
/test_results2.txt

# WorkBuddy AI 工作区数据（memory 等，不入库）
/.workbuddy-ai/

# ─── 秘密与本地凭据：绝不入库 ───────────────────────────────
# benchmark/api_key.txt 里曾放过真实 DeepSeek Key（当前未入库，但一次
# `git add -A` 就会提交）。用规则挡死，而不是靠人记得。
api_key.txt
**/api_key.txt
*.key
*.pem
*.jks
!keystore/*.jks
.env
.env.*
*_token
**/secrets/

# 基准测试的原始产物与本地分组数据，按需手动 add
benchmarks/**/raw/
benchmark/results.jsonl
benchmark/kb_*/

# CI 脚本本机验证时下载的 v1.3.1 夹具 APK，属于可再生的外部产物
/fixtures/

# 本地跑门禁脚本时 Python 落的字节码，不是仓库内容
__pycache__/

# 本机 scratch 与"绝不删除、只搬走"的落点（协议要求保留文件，但不属于仓库内容）
/_temp/
/_archive/
