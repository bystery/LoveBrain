<?xml version="1.0" encoding="utf-8"?>
<!-- RA-05: 默认禁止明文 HTTP，仅放行 loopback 主机（本地 LLM / Ollama / LM Studio）。
     与 HttpsTrustGuard 保持同一最小信任范围。 -->
<network-security-config>

    <base-config
        cleartextTrafficPermitted="false" />

    <domain-config
        cleartextTrafficPermitted="true">

        <domain includeSubdomains="false">
            localhost
        </domain>

        <domain includeSubdomains="false">
            127.0.0.1
        </domain>

        <domain includeSubdomains="false">
            ::1
        </domain>

    </domain-config>

</network-security-config>
